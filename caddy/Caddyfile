{
    admin off
    on_demand_tls {
        ask http://master_dashboard:3000/api/v1/domains/validate
        interval 1m
        burst 10
    }
}

# Master Fleet Dashboard Entrypoint
http://{$MASTER_DOMAIN:localhost}, https://{$MASTER_DOMAIN:localhost} {
    reverse_proxy master_dashboard:3000 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }
}

# Dynamic Ingress for All School Subdomains (*.yournetwork.com) and Custom Domains
:80, :443 {
    tls {
        on_demand
    }

    reverse_proxy master_dashboard:3000 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }
}
