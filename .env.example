# ==============================================================================
# Smart School Multi-Tenant Platform — Environment Secrets
# Copy this file to `.env` and replace every placeholder with a strong secret.
# `.env` is gitignored and must never be committed.
# ==============================================================================

# Master dashboard operator account (replace both values)
MASTER_ADMIN_USER=replace-me
MASTER_ADMIN_PASS=replace-with-a-long-random-password

# Express session signing secret (replace with a long random string)
SESSION_SECRET=replace-with-a-long-random-string

# Shared SSO secret. MUST match MASTER_SSO_SECRET set on every school tenant.
MASTER_SSO_SECRET=replace-with-a-long-random-string

# Fleet MariaDB credentials
FLEET_DB_HOST=fleet_db
FLEET_DB_PORT=3306
FLEET_DB_USER=root
FLEET_DB_PASSWORD=replace-with-a-long-random-db-password
MASTER_DB_NAME=ss_master_orchestrator

# Optional integrations
# EASYPANEL_MCP_URL=https://your-easypanel-mcp-endpoint
# EASYPANEL_PROJECT=manage
# EASYPANEL_SERVICE=school-crm
