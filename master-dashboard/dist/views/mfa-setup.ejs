<%- include('partials/header') %>

<div class="mb-8">
  <h1 class="text-2xl font-extrabold text-white tracking-tight">Setup Two-Factor Authentication</h1>
  <p class="text-slate-400 text-sm mt-1">Enabling MFA for <span class="text-indigo-400 font-mono"><%= user.username %></span>.</p>
</div>

<% if (error) { %>
  <div class="p-4 mb-6 rounded-2xl bg-rose-500/10 border border-rose-500/20 text-rose-400 text-xs font-medium">
    <span>⚠️</span> <%= error %>
  </div>
<% } %>

<div class="max-w-xl glass-card rounded-2xl p-6 border border-slate-800 shadow-xl">
  <div class="mb-5">
    <h3 class="text-xs font-bold uppercase tracking-wider text-white mb-2">1. Add this account to your authenticator app</h3>
    <p class="text-xs text-slate-400">Scan the QR code or enter the secret manually in Google Authenticator, Authy, 1Password, or any TOTP app.</p>
  </div>

  <div class="p-4 bg-slate-900/80 rounded-xl border border-slate-800 mb-5">
    <p class="text-[11px] text-slate-400 uppercase tracking-wider mb-2">Secret Key</p>
    <code class="text-indigo-300 font-mono text-sm break-all"><%= secret %></code>
  </div>

  <div class="p-4 bg-slate-900/80 rounded-xl border border-slate-800 mb-6">
    <p class="text-[11px] text-slate-400 uppercase tracking-wider mb-2">OTP Auth URL</p>
    <code class="text-slate-300 font-mono text-[11px] break-all"><%= otpauthUrl %></code>
  </div>

  <div class="mb-5">
    <h3 class="text-xs font-bold uppercase tracking-wider text-white mb-2">2. Verify the code</h3>
    <p class="text-xs text-slate-400 mb-4">Enter the current 6-digit code to confirm and activate MFA.</p>
  </div>

  <form action="/users/<%= user.id %>/mfa-confirm" method="POST" class="space-y-4">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="text" name="code" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6}" maxlength="6" required autofocus class="w-full px-4 py-3 bg-slate-900 border border-slate-700/80 rounded-xl text-white text-sm font-mono tracking-widest text-center focus:outline-none focus:border-indigo-500 transition" />
    <button type="submit" class="w-full py-3 bg-indigo-600 hover:bg-indigo-500 text-white rounded-xl text-xs font-bold transition">
      Confirm & Activate MFA
    </button>
  </form>
</div>

<%- include('partials/footer') %>
