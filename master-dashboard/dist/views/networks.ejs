<%- include('partials/header') %>

<div class="mb-6">
  <h1 class="text-xl sm:text-2xl font-bold text-white tracking-tight">Networks &amp; Custom Domain Routing</h1>
  <p class="text-slate-400 text-xs sm:text-sm mt-0.5">Configure root networks for reseller white-labeling, bind custom domains to schools, and verify live DNS propagation.</p>
</div>

<% if (error) { %>
  <div class="p-3.5 mb-5 rounded-lg bg-rose-500/10 border border-rose-500/20 text-rose-400 text-xs font-medium flex items-center space-x-2">
    <i data-lucide="alert-triangle" class="w-4 h-4 text-rose-400"></i>
    <span><%= error %></span>
  </div>
<% } %>

<% if (success) { %>
  <div class="p-3.5 mb-5 rounded-lg bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-xs font-medium flex items-center space-x-2">
    <i data-lucide="check-circle" class="w-4 h-4 text-emerald-400"></i>
    <span><%= success %></span>
  </div>
<% } %>

<!-- Section 1: Live DNS Verification Tool -->
<div class="control-surface p-5 mb-6">
  <div class="flex items-center space-x-2 mb-2">
    <i data-lucide="globe" class="w-4 h-4 text-indigo-400"></i>
    <h2 class="text-sm font-semibold text-white">Live Custom Domain DNS Checker</h2>
  </div>
  <p class="text-xs text-slate-400 mb-4">Before enabling a custom domain for a school, verify that their CNAME or A-record resolves to your server ingress.</p>

  <form action="/networks/verify-domain" method="POST" class="grid grid-cols-1 md:grid-cols-3 gap-3">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div>
      <label class="block text-[11px] font-medium text-slate-400 mb-1">School Custom Domain</label>
      <input type="text" name="domain" placeholder="e.g. portal.greenwoodhigh.edu" required class="w-full px-3 py-1.5 bg-slate-900 border border-slate-800 rounded-lg text-white text-xs font-mono focus:outline-none focus:border-indigo-500 transition" />
    </div>

    <div>
      <label class="block text-[11px] font-medium text-slate-400 mb-1">Expected Ingress Host / IP</label>
      <input type="text" name="expectedTarget" value="ingress.yournetwork.com" class="w-full px-3 py-1.5 bg-slate-900 border border-slate-800 rounded-lg text-white text-xs font-mono focus:outline-none focus:border-indigo-500 transition" />
    </div>

    <div class="flex items-end">
      <button type="submit" class="w-full btn-control btn-control-primary justify-center">
        <i data-lucide="check" class="w-3.5 h-3.5"></i>
        <span>Run Live DNS Check</span>
      </button>
    </div>
  </form>

  <% if (dnsResult) { %>
    <div class="mt-4 p-3.5 rounded-lg border text-xs <%= dnsResult.isConfigured ? 'bg-emerald-500/10 border-emerald-500/20 text-emerald-400' : 'bg-rose-500/10 border-rose-500/20 text-rose-400' %> flex items-start space-x-3">
      <i data-lucide="<%= dnsResult.isConfigured ? 'check-circle' : 'x-circle' %>" class="w-4 h-4 shrink-0 mt-0.5"></i>
      <div>
        <div class="font-bold mb-1">
          <%= dnsResult.isConfigured ? 'DNS Verified & Ready for On-Demand TLS' : 'DNS Records Not Yet Pointing to Ingress' %>
        </div>
        <div>Domain: <span class="font-mono"><%= dnsResult.domain %></span></div>
        <div>Records Found: <span class="font-mono"><%= dnsResult.recordsFound.length > 0 ? dnsResult.recordsFound.join(', ') : 'None' %></span></div>
        <% if (dnsResult.error) { %>
          <div class="text-[11px] text-slate-400 mt-1">Details: <%= dnsResult.error %></div>
        <% } %>
      </div>
    </div>
  <% } %>
</div>

<div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6">
  <!-- Section 2: Active Networks (Reseller / Group Chains) -->
  <div class="control-surface p-5">
    <div class="flex items-center justify-between mb-3 pb-2 border-b border-slate-800">
      <h2 class="text-xs font-semibold text-white flex items-center space-x-2">
        <i data-lucide="network" class="w-4 h-4 text-indigo-400"></i>
        <span>Active Root Networks</span>
      </h2>
      <span class="text-xs text-indigo-400 font-medium"><%= networks.length %> Networks</span>
    </div>

    <div class="space-y-2.5 mb-5">
      <% networks.forEach(function(n) { %>
        <div class="p-3 bg-slate-900 rounded-lg border border-slate-800 flex items-center justify-between">
          <div>
            <div class="flex items-center space-x-2">
              <span class="font-semibold text-white text-xs"><%= n.name %></span>
              <% if (n.isDefault) { %>
                <span class="px-1.5 py-0.2 rounded text-[10px] font-bold bg-indigo-500/10 text-indigo-400 border border-indigo-500/20">Default</span>
              <% } %>
            </div>
            <p class="text-xs font-mono text-indigo-400 mt-0.5">*. <%= n.rootDomain %></p>
            <% if (n.description) { %>
              <p class="text-[11px] text-slate-400 mt-0.5"><%= n.description %></p>
            <% } %>
          </div>
          <span class="text-xs text-slate-400 flex items-center space-x-1">
            <i data-lucide="lock" class="w-3.5 h-3.5 text-emerald-400"></i>
            <span>Auto-SSL</span>
          </span>
        </div>
      <% }); %>
    </div>

    <!-- Add Network Form -->
    <div class="pt-3 border-t border-slate-800">
      <h3 class="text-xs font-semibold text-slate-300 mb-2">Register Additional Network</h3>
      <form action="/networks/create" method="POST" class="space-y-2.5">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div>
          <input type="text" name="name" required placeholder="Network Name (e.g. Cambridge Group)" class="w-full px-3 py-1.5 bg-slate-900 border border-slate-800 rounded-lg text-white text-xs focus:outline-none focus:border-indigo-500 transition" />
        </div>
        <div>
          <input type="text" name="rootDomain" required placeholder="Root Domain (e.g. cambridge-edu.org)" class="w-full px-3 py-1.5 bg-slate-900 border border-slate-800 rounded-lg text-white text-xs font-mono focus:outline-none focus:border-indigo-500 transition" />
        </div>
        <div>
          <input type="text" name="description" placeholder="Notes or organization name" class="w-full px-3 py-1.5 bg-slate-900 border border-slate-800 rounded-lg text-white text-xs focus:outline-none focus:border-indigo-500 transition" />
        </div>
        <button type="submit" class="w-full btn-control btn-control-secondary justify-center">
          <i data-lucide="plus" class="w-3.5 h-3.5"></i>
          <span>Register Root Network</span>
        </button>
      </form>
    </div>
  </div>

  <!-- Section 3: Bind Custom Domain to School -->
  <div class="control-surface p-5 flex flex-col justify-between">
    <div>
      <div class="border-b border-slate-800 pb-2 mb-3">
        <h2 class="text-xs font-semibold text-white flex items-center space-x-2">
          <i data-lucide="link-2" class="w-4 h-4 text-indigo-400"></i>
          <span>Bind Custom Domain to School</span>
        </h2>
        <p class="text-xs text-slate-400 mt-0.5">Attach a client's dedicated apex or subdomain. The Caddy reverse proxy will issue a Let's Encrypt certificate automatically via On-Demand TLS upon first request.</p>
      </div>

      <form action="/networks/bind-domain" method="POST" class="space-y-3">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div>
          <label class="block text-xs font-medium text-slate-300 mb-1">Select School Instance</label>
          <select name="schoolId" class="w-full px-3 py-1.5 bg-slate-900 border border-slate-800 rounded-lg text-white text-xs focus:outline-none focus:border-indigo-500 transition">
            <% schools.forEach(function(s) { %>
              <option value="<%= s.id %>"><%= s.name %> (<%= s.slug %>)</option>
            <% }); %>
          </select>
        </div>

        <div>
          <label class="block text-xs font-medium text-slate-300 mb-1">Custom Domain</label>
          <input type="text" name="customDomain" placeholder="portal.clientschool.edu" required class="w-full px-3 py-1.5 bg-slate-900 border border-slate-800 rounded-lg text-white text-xs font-mono focus:outline-none focus:border-indigo-500 transition" />
        </div>

        <button type="submit" class="w-full btn-control btn-control-primary justify-center">
          <i data-lucide="link" class="w-3.5 h-3.5"></i>
          <span>Bind Domain &amp; Enable Auto-SSL</span>
        </button>
      </form>
    </div>

    <!-- On Demand SSL Notice -->
    <div class="mt-4 p-3 bg-indigo-500/5 rounded-lg border border-indigo-500/20 text-xs text-slate-400 flex items-start space-x-2">
      <i data-lucide="shield-check" class="w-4 h-4 text-indigo-400 shrink-0 mt-0.5"></i>
      <div>
        <span class="font-semibold text-indigo-300 block mb-0.5">Automated On-Demand TLS Engine</span>
        When the client points their CNAME record to your ingress, Caddy will verify the domain through the Master Dashboard API (<code class="text-slate-300">/api/v1/domains/validate</code>) and provision HTTPS within seconds.
      </div>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
