<%- include('partials/header') %>

<!-- Flash Notifications -->
<% if (success) { %>
  <div class="mb-6 p-4 rounded-2xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-xs flex items-center justify-between shadow-lg shadow-emerald-500/5">
    <div class="flex items-center space-x-2">
      <span class="text-base">✅</span>
      <span class="font-medium"><%= success %></span>
    </div>
    <a href="/schools/<%= school.id %>" class="text-slate-400 hover:text-white text-[11px]">Dismiss</a>
  </div>
<% } %>

<% if (error) { %>
  <div class="mb-6 p-4 rounded-2xl bg-rose-500/10 border border-rose-500/20 text-rose-400 text-xs flex items-center justify-between shadow-lg shadow-rose-500/5">
    <div class="flex items-center space-x-2">
      <span class="text-base">⚠️</span>
      <span class="font-medium"><%= error %></span>
    </div>
    <a href="/schools/<%= school.id %>" class="text-slate-400 hover:text-white text-[11px]">Dismiss</a>
  </div>
<% } %>

<!-- Header Bar -->
<div class="mb-8 flex flex-col md:flex-row md:items-center md:justify-between gap-4">
  <div>
    <div class="flex items-center space-x-2 text-xs text-slate-400 mb-1">
      <a href="/schools" class="hover:text-indigo-400">Schools Fleet</a>
      <span>/</span>
      <span class="font-mono text-slate-300"><%= school.slug %></span>
    </div>
    <div class="flex items-center space-x-3">
      <h1 class="text-2xl font-extrabold text-white tracking-tight"><%= school.name %></h1>
      <% if (school.status === 'active') { %>
        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
          ● Active
        </span>
      <% } else if (school.status === 'suspended') { %>
        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-amber-500/10 text-amber-400 border border-amber-500/20">
          ● Suspended
        </span>
      <% } else { %>
        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-slate-500/10 text-slate-400 border border-slate-500/20">
          ● Stopped
        </span>
      <% } %>
    </div>
  </div>

  <!-- Primary Action Controls -->
  <div class="flex flex-wrap items-center gap-3">
    <!-- Download SQL Backup -->
    <a href="/schools/<%= school.id %>/backup-db" class="px-4 py-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs font-bold border border-slate-700 transition flex items-center space-x-2 shadow-sm">
      <span>💾</span>
      <span>Download Backup (.sql)</span>
    </a>

    <!-- Primary SSO Button -->
    <a href="/schools/<%= school.id %>/sso-login" target="_blank" class="px-5 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-bold shadow-lg shadow-indigo-600/30 transition flex items-center space-x-2">
      <span>⚡</span>
      <span>Login as Super Admin (SSO)</span>
    </a>
  </div>
</div>

<!-- 5-Panel High-Control Grid -->
<div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-8">

  <!-- Panel 1: Live Domain & Public Routing -->
  <div class="glass-card rounded-2xl p-6 border border-slate-800 space-y-4 shadow-xl">
    <div class="flex items-center justify-between border-b border-slate-800/80 pb-3">
      <h3 class="text-xs font-bold uppercase tracking-wider text-indigo-400 flex items-center space-x-2">
        <span>🌐</span>
        <span>Live Domain & Routing</span>
      </h3>
      <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-slate-800 text-slate-300">Port 80/443</span>
    </div>

    <div class="space-y-3 text-xs">
      <div>
        <span class="text-slate-400 block text-[11px] mb-1">Primary School Access URL:</span>
        <a href="https://<%= school.customDomain || school.subdomain %>" target="_blank" class="font-mono text-emerald-400 hover:underline flex items-center space-x-1.5 break-all bg-emerald-500/5 p-2.5 rounded-xl border border-emerald-500/20 font-bold">
          <span>🔗</span>
          <span>https://<%= school.customDomain || school.subdomain %></span>
          <span class="text-[10px]">↗</span>
        </a>
      </div>

      <div class="pt-2 border-t border-slate-800/60 flex justify-between">
        <span class="text-slate-400">Fleet Subdomain:</span>
        <span class="font-mono text-slate-200"><%= school.subdomain %></span>
      </div>

      <div class="flex justify-between">
        <span class="text-slate-400">Custom Domain:</span>
        <span class="font-mono <%= school.customDomain ? 'text-emerald-400 font-semibold' : 'text-slate-500' %>">
          <%= school.customDomain || 'None configured' %>
        </span>
      </div>

      <div class="flex justify-between">
        <span class="text-slate-400">SSL Certificate:</span>
        <span class="inline-flex items-center space-x-1 text-emerald-400 font-semibold">
          <span>🔒</span>
          <span>Auto-TLS Active</span>
        </span>
      </div>

      <div class="pt-2 border-t border-slate-800/60 flex justify-between">
        <span class="text-slate-400">Cluster Host:</span>
        <span class="font-mono text-slate-300"><%= currentHost %></span>
      </div>

      <!-- DNS Instructions Box -->
      <div class="mt-4 p-3 bg-slate-900/90 rounded-xl border border-slate-800 text-[11px] text-slate-400">
        <span class="font-semibold text-slate-300 block mb-1">💡 Custom Domain DNS Mapping:</span>
        Point your school's DNS <code class="text-indigo-400">CNAME</code> record to <code class="text-slate-200 font-mono"><%= currentHost %></code>.
      </div>
    </div>
  </div>

  <!-- Panel 2: Super Admin Security & Password Reset -->
  <div class="glass-card rounded-2xl p-6 border border-slate-800 space-y-4 shadow-xl">
    <div class="flex items-center justify-between border-b border-slate-800/80 pb-3">
      <h3 class="text-xs font-bold uppercase tracking-wider text-amber-400 flex items-center space-x-2">
        <span>🔑</span>
        <span>Super Admin Security</span>
      </h3>
      <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-amber-500/10 text-amber-400">Role ID: 7</span>
    </div>

    <div class="space-y-3 text-xs">
      <div class="flex justify-between py-1">
        <span class="text-slate-400">Super Admin Email:</span>
        <span class="font-mono text-white font-medium"><%= school.adminEmail %></span>
      </div>

      <div class="flex justify-between py-1 border-b border-slate-800/60 pb-3">
        <span class="text-slate-400">Direct Impersonation:</span>
        <a href="/schools/<%= school.id %>/sso-login" target="_blank" class="text-indigo-400 hover:text-indigo-300 font-semibold flex items-center space-x-1">
          <span>⚡ Launch SSO</span>
          <span>↗</span>
        </a>
      </div>

      <!-- Password Reset Form -->
      <form action="/schools/<%= school.id %>/reset-password" method="POST" class="space-y-3 pt-1">
        <div>
          <label class="block text-[11px] font-semibold text-slate-300 mb-1">Reset Super Admin Password</label>
          <input type="text" name="newPassword" placeholder="Enter new password (min 6 chars)" required minlength="6" class="w-full px-3.5 py-2.5 bg-slate-900 border border-slate-700/80 rounded-xl text-white text-xs font-mono focus:outline-none focus:border-amber-500 transition" />
        </div>
        <button type="submit" class="w-full py-2.5 px-4 bg-amber-500/10 hover:bg-amber-500/20 text-amber-300 rounded-xl text-xs font-bold border border-amber-500/30 transition shadow-sm flex items-center justify-center space-x-1.5">
          <span>🔑</span>
          <span>Update Password in MariaDB</span>
        </button>
      </form>
      <p class="text-[10px] text-slate-500 text-center">Instantly hashes with bcrypt ($2y$) and updates employee #9000.</p>
    </div>
  </div>

  <!-- Panel 3: Live MariaDB Telemetry & Data Management -->
  <div class="glass-card rounded-2xl p-6 border border-slate-800 space-y-4 shadow-xl">
    <div class="flex items-center justify-between border-b border-slate-800/80 pb-3">
      <h3 class="text-xs font-bold uppercase tracking-wider text-emerald-400 flex items-center space-x-2">
        <span>🗄️</span>
        <span>Database & Telemetry</span>
      </h3>
      <% if (dbStats.isOnline) { %>
        <span class="text-[10px] font-semibold px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">● Online</span>
      <% } else { %>
        <span class="text-[10px] font-semibold px-2 py-0.5 rounded bg-rose-500/10 text-rose-400 border border-rose-500/20">○ Disconnected</span>
      <% } %>
    </div>

    <div class="space-y-3 text-xs">
      <div class="flex justify-between py-1">
        <span class="text-slate-400">Database Name:</span>
        <span class="font-mono text-indigo-400 font-bold"><%= school.dbName %></span>
      </div>

      <div class="grid grid-cols-2 gap-3 py-2">
        <div class="p-3 bg-slate-900/90 rounded-xl border border-slate-800 text-center">
          <span class="text-[10px] text-slate-400 uppercase tracking-wider block">Tables</span>
          <span class="text-lg font-extrabold text-white"><%= dbStats.tableCount %></span>
        </div>
        <div class="p-3 bg-slate-900/90 rounded-xl border border-slate-800 text-center">
          <span class="text-[10px] text-slate-400 uppercase tracking-wider block">DB Size</span>
          <span class="text-lg font-extrabold text-indigo-400"><%= dbStats.sizeMb %> <span class="text-xs font-normal">MB</span></span>
        </div>
        <div class="p-3 bg-slate-900/90 rounded-xl border border-slate-800 text-center">
          <span class="text-[10px] text-slate-400 uppercase tracking-wider block">Students</span>
          <span class="text-lg font-extrabold text-emerald-400"><%= dbStats.studentsCount %></span>
        </div>
        <div class="p-3 bg-slate-900/90 rounded-xl border border-slate-800 text-center">
          <span class="text-[10px] text-slate-400 uppercase tracking-wider block">Staff</span>
          <span class="text-lg font-extrabold text-amber-400"><%= dbStats.staffCount %></span>
        </div>
      </div>

      <!-- 1-Click SQL Backup -->
      <div class="pt-2">
        <a href="/schools/<%= school.id %>/backup-db" class="w-full py-2.5 px-4 bg-indigo-600/20 hover:bg-indigo-600/30 text-indigo-300 rounded-xl text-xs font-bold border border-indigo-500/30 transition shadow-sm flex items-center justify-center space-x-2">
          <span>💾</span>
          <span>Download Complete SQL Dump</span>
        </a>
      </div>
    </div>
  </div>
</div>

<!-- Bottom Grid: Configuration Editor & Runtime Lifecycle -->
<div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-8">

  <!-- Panel 4: School Configuration & Quotas Editor -->
  <div class="glass-card rounded-2xl p-6 border border-slate-800 shadow-xl space-y-4">
    <div class="border-b border-slate-800/80 pb-3">
      <h3 class="text-xs font-bold uppercase tracking-wider text-white flex items-center space-x-2">
        <span>⚙️</span>
        <span>Edit School Configuration & Quotas</span>
      </h3>
      <p class="text-xs text-slate-400 mt-1">Update display identity, bound custom domains, storage allocations, or student limits.</p>
    </div>

    <form action="/schools/<%= school.id %>/edit" method="POST" class="space-y-4 text-xs">
      <div>
        <label class="block text-[11px] font-medium text-slate-300 mb-1">School Name</label>
        <input type="text" name="name" value="<%= school.name %>" required class="w-full px-3.5 py-2.5 bg-slate-900 border border-slate-700/80 rounded-xl text-white text-xs focus:outline-none focus:border-indigo-500 transition" />
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label class="block text-[11px] font-medium text-slate-300 mb-1">Admin Contact Email</label>
          <input type="email" name="adminEmail" value="<%= school.adminEmail %>" required class="w-full px-3.5 py-2.5 bg-slate-900 border border-slate-700/80 rounded-xl text-white text-xs focus:outline-none focus:border-indigo-500 transition" />
        </div>

        <div>
          <label class="block text-[11px] font-medium text-slate-300 mb-1">Custom Domain (Optional)</label>
          <input type="text" name="customDomain" value="<%= school.customDomain || '' %>" placeholder="e.g. portal.school.edu" class="w-full px-3.5 py-2.5 bg-slate-900 border border-slate-700/80 rounded-xl text-white text-xs font-mono focus:outline-none focus:border-indigo-500 transition" />
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div>
          <label class="block text-[11px] font-medium text-slate-300 mb-1">Storage Quota (GB)</label>
          <input type="number" name="storageQuotaGb" value="<%= school.storageQuotaGb %>" min="1" max="500" required class="w-full px-3.5 py-2.5 bg-slate-900 border border-slate-700/80 rounded-xl text-white text-xs focus:outline-none focus:border-indigo-500 transition" />
        </div>

        <div>
          <label class="block text-[11px] font-medium text-slate-300 mb-1">Max Students</label>
          <input type="number" name="maxStudents" value="<%= school.maxStudents %>" min="10" max="50000" required class="w-full px-3.5 py-2.5 bg-slate-900 border border-slate-700/80 rounded-xl text-white text-xs focus:outline-none focus:border-indigo-500 transition" />
        </div>

        <div>
          <label class="block text-[11px] font-medium text-slate-300 mb-1">School Status</label>
          <select name="status" class="w-full px-3.5 py-2.5 bg-slate-900 border border-slate-700/80 rounded-xl text-white text-xs focus:outline-none focus:border-indigo-500 transition">
            <option value="active" <%= school.status === 'active' ? 'selected' : '' %>>Active</option>
            <option value="suspended" <%= school.status === 'suspended' ? 'selected' : '' %>>Suspended</option>
            <option value="stopped" <%= school.status === 'stopped' ? 'selected' : '' %>>Stopped / Maintenance</option>
          </select>
        </div>
      </div>

      <div class="pt-2 flex justify-end">
        <button type="submit" class="px-6 py-2.5 bg-indigo-600 hover:bg-indigo-500 text-white rounded-xl text-xs font-bold shadow-md shadow-indigo-600/20 transition">
          💾 Save Changes
        </button>
      </div>
    </form>
  </div>

  <!-- Panel 5: Runtime Lifecycle Controls & Container Logs -->
  <div class="glass-card rounded-2xl p-6 border border-slate-800 shadow-xl flex flex-col justify-between space-y-6">
    <div>
      <div class="border-b border-slate-800/80 pb-3 mb-4">
        <h3 class="text-xs font-bold uppercase tracking-wider text-slate-400 flex items-center space-x-2">
          <span>📦</span>
          <span>Container Runtime Controls</span>
        </h3>
        <p class="text-xs text-slate-400 mt-1">Docker Target: <code class="text-indigo-400 font-mono"><%= school.containerName %></code> (<%= containerStatus %>)</p>
      </div>

      <!-- Action Buttons Grid -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-6">
        <% if (school.status === 'active') { %>
          <form action="/schools/<%= school.id %>/restart" method="POST">
            <button type="submit" class="w-full py-2.5 px-3 bg-slate-800 hover:bg-slate-700 text-white rounded-xl text-xs font-semibold border border-slate-700 transition">
              🔄 Restart
            </button>
          </form>

          <form action="/schools/<%= school.id %>/stop" method="POST">
            <button type="submit" class="w-full py-2.5 px-3 bg-slate-800 hover:bg-slate-700 text-amber-400 rounded-xl text-xs font-semibold border border-slate-700 transition">
              ⏹️ Stop
            </button>
          </form>

          <form action="/schools/<%= school.id %>/suspend" method="POST">
            <button type="submit" class="w-full py-2.5 px-3 bg-amber-500/10 hover:bg-amber-500/20 text-amber-300 rounded-xl text-xs font-semibold border border-amber-500/30 transition">
              ⚠️ Suspend
            </button>
          </form>
        <% } else if (school.status === 'suspended') { %>
          <form action="/schools/<%= school.id %>/activate" method="POST">
            <button type="submit" class="w-full py-2.5 px-3 bg-emerald-600 hover:bg-emerald-500 text-white rounded-xl text-xs font-semibold transition">
              ✅ Unsuspend
            </button>
          </form>
        <% } else { %>
          <form action="/schools/<%= school.id %>/start" method="POST">
            <button type="submit" class="w-full py-2.5 px-3 bg-emerald-600 hover:bg-emerald-500 text-white rounded-xl text-xs font-semibold transition">
              ▶️ Start
            </button>
          </form>
        <% } %>

        <form action="/schools/<%= school.id %>/delete" method="POST" onsubmit="return confirm('Are you sure you want to permanently delete this school and container?');">
          <button type="submit" class="w-full py-2.5 px-3 bg-rose-500/10 hover:bg-rose-500/20 text-rose-400 rounded-xl text-xs font-semibold border border-rose-500/30 transition">
            🗑️ Delete
          </button>
        </form>
      </div>
    </div>

    <!-- Live Container Log Stream -->
    <div>
      <h4 class="text-xs font-semibold text-slate-400 mb-2 flex items-center justify-between">
        <span>Container Runtime Logs (Last 50 lines)</span>
        <span class="text-[10px] font-mono text-emerald-400">● Live Buffer</span>
      </h4>
      <pre class="bg-slate-950 p-4 rounded-xl text-[11px] font-mono text-slate-300 overflow-x-auto max-h-52 border border-slate-800/80"><%= logs %></pre>
    </div>
  </div>
</div>

<%- include('partials/footer') %>

