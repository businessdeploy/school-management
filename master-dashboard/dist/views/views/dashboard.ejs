<%- include('partials/header') %>

<!-- Top Hero / Action Section -->
<div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-8">
  <div>
    <h1 class="text-2xl font-extrabold text-white tracking-tight">Fleet Command Overview</h1>
    <p class="text-slate-400 text-sm mt-1">Multi-Tenant Education Cloud • Isolated Instances • Central Telemetry</p>
  </div>
  <div class="flex items-center space-x-3">
    <a href="/master-data" class="px-4 py-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs font-semibold border border-slate-700 transition flex items-center space-x-2">
      <span>🔍</span>
      <span>Cross-School Search</span>
    </a>
    <a href="/schools/new" class="px-5 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-semibold shadow-lg shadow-indigo-600/25 transition flex items-center space-x-2">
      <span class="text-base leading-none">✨</span>
      <span>Onboard New School</span>
    </a>
  </div>
</div>

<!-- Key Telemetry Cards -->
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5 mb-8">
  <!-- Total Schools -->
  <div class="glass-card rounded-2xl p-6 relative overflow-hidden border border-slate-800">
    <div class="flex items-center justify-between mb-3">
      <span class="text-xs font-semibold uppercase tracking-wider text-slate-400">Total Schools</span>
      <span class="p-2.5 rounded-xl bg-indigo-500/10 text-indigo-400 text-lg">🏫</span>
    </div>
    <div class="flex items-baseline space-x-2">
      <span class="text-3xl font-extrabold text-white"><%= telemetry.schools.length %></span>
      <span class="text-xs text-emerald-400 font-medium">100% Isolated</span>
    </div>
    <p class="text-xs text-slate-500 mt-2">Active instances across all networks</p>
  </div>

  <!-- Total Students -->
  <div class="glass-card rounded-2xl p-6 relative overflow-hidden border border-slate-800">
    <div class="flex items-center justify-between mb-3">
      <span class="text-xs font-semibold uppercase tracking-wider text-slate-400">Total Students</span>
      <span class="p-2.5 rounded-xl bg-emerald-500/10 text-emerald-400 text-lg">🎓</span>
    </div>
    <div class="flex items-baseline space-x-2">
      <span class="text-3xl font-extrabold text-white"><%= telemetry.totalStudents.toLocaleString() %></span>
      <span class="text-xs text-emerald-400 font-medium">Enrolled</span>
    </div>
    <p class="text-xs text-slate-500 mt-2">Across all tenant databases</p>
  </div>

  <!-- Total Staff / Faculty -->
  <div class="glass-card rounded-2xl p-6 relative overflow-hidden border border-slate-800">
    <div class="flex items-center justify-between mb-3">
      <span class="text-xs font-semibold uppercase tracking-wider text-slate-400">Teachers & Staff</span>
      <span class="p-2.5 rounded-xl bg-amber-500/10 text-amber-400 text-lg">👩‍🏫</span>
    </div>
    <div class="flex items-baseline space-x-2">
      <span class="text-3xl font-extrabold text-white"><%= telemetry.totalStaff.toLocaleString() %></span>
      <span class="text-xs text-amber-400 font-medium">Active</span>
    </div>
    <p class="text-xs text-slate-500 mt-2">Faculty across all campuses</p>
  </div>

  <!-- Total Collections -->
  <div class="glass-card rounded-2xl p-6 relative overflow-hidden border border-slate-800">
    <div class="flex items-center justify-between mb-3">
      <span class="text-xs font-semibold uppercase tracking-wider text-slate-400">Fleet Collections</span>
      <span class="p-2.5 rounded-xl bg-purple-500/10 text-purple-400 text-lg">💰</span>
    </div>
    <div class="flex items-baseline space-x-2">
      <span class="text-3xl font-extrabold text-white">$<%= telemetry.totalCollected.toLocaleString() %></span>
      <span class="text-xs text-purple-400 font-medium">Fees Collected</span>
    </div>
    <p class="text-xs text-slate-500 mt-2">Aggregated payment ledger</p>
  </div>
</div>

<!-- Active Schools Fleet Grid -->
<div class="mb-8">
  <div class="flex items-center justify-between mb-4">
    <h2 class="text-lg font-bold text-white tracking-tight">Active School Fleet</h2>
    <a href="/schools" class="text-xs text-indigo-400 hover:text-indigo-300 font-semibold">View All Instances →</a>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-5">
    <% telemetry.schools.forEach(function(s) { %>
      <div class="glass-card rounded-2xl p-6 border border-slate-800 hover:border-slate-700 transition">
        <div class="flex items-start justify-between mb-4">
          <div class="flex items-center space-x-3.5">
            <div class="w-12 h-12 rounded-2xl bg-indigo-600/10 text-indigo-400 border border-indigo-500/20 flex items-center justify-center font-bold text-xl">
              🏫
            </div>
            <div>
              <h3 class="text-base font-bold text-white"><%= s.name %></h3>
              <p class="text-xs text-slate-400 font-mono mt-0.5"><%= s.subdomain %></p>
            </div>
          </div>
          <div>
            <% if (s.status === 'active') { %>
              <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
                ● Active
              </span>
            <% } else if (s.status === 'suspended') { %>
              <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold bg-amber-500/10 text-amber-400 border border-amber-500/20">
                ● Suspended
              </span>
            <% } else { %>
              <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold bg-slate-500/10 text-slate-400 border border-slate-500/20">
                ● Stopped
              </span>
            <% } %>
          </div>
        </div>

        <!-- School Stats Bar -->
        <div class="grid grid-cols-3 gap-3 p-3.5 bg-slate-900/80 rounded-xl mb-5 text-center text-xs">
          <div>
            <span class="text-slate-400 block text-[11px]">Students</span>
            <span class="font-bold text-white text-sm"><%= s.studentsCount %></span>
          </div>
          <div>
            <span class="text-slate-400 block text-[11px]">Teachers</span>
            <span class="font-bold text-white text-sm"><%= s.staffCount %></span>
          </div>
          <div>
            <span class="text-slate-400 block text-[11px]">Collections</span>
            <span class="font-bold text-emerald-400 text-sm">$<%= s.totalFeesCollected.toLocaleString() %></span>
          </div>
        </div>

        <!-- Action Buttons (Including 1-Click Master SSO) -->
        <div class="flex items-center space-x-3">
          <a href="/schools/<%= s.schoolId %>/sso-login" target="_blank" class="flex-1 py-2.5 px-4 bg-indigo-600 hover:bg-indigo-500 text-white rounded-xl text-xs font-semibold text-center shadow-md shadow-indigo-600/20 transition flex items-center justify-center space-x-2">
            <span>⚡</span>
            <span>Login as Super Admin</span>
          </a>
          <a href="/schools/<%= s.schoolId %>" class="py-2.5 px-4 bg-slate-800 hover:bg-slate-700 text-slate-300 rounded-xl text-xs font-semibold border border-slate-700 transition">
            Manage Instance
          </a>
        </div>
      </div>
    <% }); %>
  </div>
</div>

<%- include('partials/footer') %>
