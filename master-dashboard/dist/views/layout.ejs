<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof pageTitle !== 'undefined' ? pageTitle : 'Control Plane' %> | Smart School Master</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
  <style>
    body { font-family: 'Plus Jakarta Sans', sans-serif; }
    .glass-card {
      background: rgba(15, 23, 42, 0.75);
      backdrop-filter: blur(12px);
      border: 1px solid rgba(255, 255, 255, 0.08);
    }
  </style>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            brand: {
              50: '#eef2ff',
              500: '#6366f1',
              600: '#4f46e5',
              700: '#4338ca',
            }
          }
        }
      }
    }
  </script>
</head>
<body class="bg-slate-950 text-slate-100 flex min-h-screen antialiased selection:bg-brand-500 selection:text-white">

  <!-- Sidebar Navigation -->
  <aside class="w-72 bg-slate-900 border-r border-slate-800 flex flex-col justify-between shrink-0">
    <div>
      <!-- Platform Brand -->
      <div class="p-6 border-b border-slate-800 flex items-center justify-between">
        <div class="flex items-center space-x-3">
          <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-brand-600 to-indigo-400 flex items-center justify-center font-bold text-lg text-white shadow-lg shadow-brand-500/20">
            ⚡
          </div>
          <div>
            <h1 class="text-base font-bold text-white tracking-tight">SmartSchool</h1>
            <p class="text-xs text-brand-400 font-medium tracking-wide uppercase">Fleet Master Control</p>
          </div>
        </div>
      </div>

      <!-- Navigation Items -->
      <nav class="p-4 space-y-1.5 text-sm font-medium">
        <a href="/" class="flex items-center space-x-3 px-4 py-3 rounded-xl transition <%= currentPath === '/' ? 'bg-brand-600 text-white shadow-md shadow-brand-600/30 font-semibold' : 'text-slate-400 hover:text-white hover:bg-slate-800/60' %>">
          <span>📊</span>
          <span>Fleet Overview</span>
        </a>

        <a href="/schools" class="flex items-center space-x-3 px-4 py-3 rounded-xl transition <%= currentPath.startsWith('/schools') && currentPath !== '/schools/new' ? 'bg-brand-600 text-white shadow-md shadow-brand-600/30 font-semibold' : 'text-slate-400 hover:text-white hover:bg-slate-800/60' %>">
          <span>🏫</span>
          <span>School Instances</span>
        </a>

        <a href="/schools/new" class="flex items-center space-x-3 px-4 py-3 rounded-xl transition <%= currentPath === '/schools/new' ? 'bg-brand-600 text-white shadow-md shadow-brand-600/30 font-semibold' : 'text-emerald-400 hover:text-emerald-300 hover:bg-emerald-500/10' %>">
          <span class="text-lg">✨</span>
          <span class="font-semibold">Onboard New School</span>
        </a>

        <a href="/master-data" class="flex items-center space-x-3 px-4 py-3 rounded-xl transition <%= currentPath.startsWith('/master-data') ? 'bg-brand-600 text-white shadow-md shadow-brand-600/30 font-semibold' : 'text-slate-400 hover:text-white hover:bg-slate-800/60' %>">
          <span>🔍</span>
          <span>Master Data & Verify</span>
        </a>

        <a href="/networks" class="flex items-center space-x-3 px-4 py-3 rounded-xl transition <%= currentPath.startsWith('/networks') ? 'bg-brand-600 text-white shadow-md shadow-brand-600/30 font-semibold' : 'text-slate-400 hover:text-white hover:bg-slate-800/60' %>">
          <span>🌐</span>
          <span>Networks & Domains</span>
        </a>
      </nav>
    </div>

    <!-- User Profile & Sign Out -->
    <div class="p-4 border-t border-slate-800">
      <div class="bg-slate-800/60 rounded-xl p-3 flex items-center justify-between">
        <div class="flex items-center space-x-3 truncate">
          <div class="w-8 h-8 rounded-full bg-brand-500/20 text-brand-400 flex items-center justify-center font-bold text-xs">
            SA
          </div>
          <div class="truncate">
            <p class="text-xs font-semibold text-white truncate"><%= user ? user.username : 'Super Admin' %></p>
            <p class="text-[10px] text-slate-400">Master Operator</p>
          </div>
        </div>
        <a href="/auth/logout" title="Sign Out" class="p-1.5 text-slate-400 hover:text-rose-400 transition">
          🚪
        </a>
      </div>
    </div>
  </aside>

  <!-- Main Content Area -->
  <main class="flex-1 flex flex-col min-w-0 overflow-y-auto">
    <!-- Top Bar -->
    <header class="h-16 border-b border-slate-800 bg-slate-900/50 backdrop-blur px-8 flex items-center justify-between shrink-0">
      <div class="flex items-center space-x-4">
        <h2 class="text-lg font-bold text-white"><%= typeof pageTitle !== 'undefined' ? pageTitle : 'Dashboard' %></h2>
      </div>

      <div class="flex items-center space-x-4 text-xs">
        <div class="flex items-center space-x-2 px-3 py-1.5 rounded-full bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 font-medium">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          <span>Fleet Mesh: Online</span>
        </div>
        <div class="text-slate-400 font-mono">
          CodeIgniter 3.1.13 | PHP 8.2 Fleet
        </div>
      </div>
    </header>

    <!-- Page Body -->
    <div class="p-8">
      <%- body %>
    </div>
  </main>

</body>
</html>
