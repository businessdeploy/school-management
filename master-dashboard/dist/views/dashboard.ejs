<%- include('partials/header') %>

<!-- Top Hero / Command Action Bar -->
<div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-8">
  <div>
    <div class="flex items-center space-x-2 text-xs text-indigo-400 font-semibold mb-1 uppercase tracking-wider">
      <i data-lucide="cpu" class="w-4 h-4"></i>
      <span>Central Fleet Management Engine</span>
    </div>
    <h1 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">Fleet Command Overview</h1>
    <p class="text-slate-400 text-xs sm:text-sm mt-1">Multi-Tenant Education Cloud • Isolated Databases • High-Performance Observability</p>
  </div>
  <div class="flex flex-wrap items-center gap-2.5">
    <a href="/schools/export/csv" class="px-3.5 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs font-semibold border border-slate-700 transition flex items-center space-x-1.5 shadow-sm">
      <i data-lucide="download" class="w-3.5 h-3.5 text-slate-400"></i>
      <span>Export CSV</span>
    </a>
    <a href="/master-data" class="px-3.5 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs font-semibold border border-slate-700 transition flex items-center space-x-1.5 shadow-sm">
      <i data-lucide="search" class="w-3.5 h-3.5 text-indigo-400"></i>
      <span>Cross-School Search</span>
    </a>
    <a href="/schools/new" class="px-4 py-2 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-semibold shadow-lg shadow-indigo-600/25 transition flex items-center space-x-1.5">
      <i data-lucide="plus" class="w-3.5 h-3.5"></i>
      <span>Onboard New School</span>
    </a>
  </div>
</div>

<!-- Key Telemetry 4-Card Grid -->
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-5 mb-8">
  <!-- Total Schools -->
  <div class="glass-card rounded-2xl p-5 sm:p-6 border border-slate-800">
    <div class="flex items-center justify-between mb-3">
      <span class="text-xs font-semibold uppercase tracking-wider text-slate-400">Total Schools</span>
      <div class="w-10 h-10 rounded-xl bg-indigo-500/10 text-indigo-400 flex items-center justify-center">
        <i data-lucide="school" class="w-5 h-5"></i>
      </div>
    </div>
    <div class="flex items-baseline space-x-2">
      <span class="text-3xl font-extrabold text-white"><%= telemetry.schools.length %></span>
      <span class="text-xs text-emerald-400 font-semibold bg-emerald-500/10 px-2 py-0.5 rounded-full border border-emerald-500/20">100% Isolated</span>
    </div>
    <p class="text-[11px] text-slate-400 mt-2">Active instances across all networks</p>
  </div>

  <!-- Total Students -->
  <div class="glass-card rounded-2xl p-5 sm:p-6 border border-slate-800">
    <div class="flex items-center justify-between mb-3">
      <span class="text-xs font-semibold uppercase tracking-wider text-slate-400">Total Students</span>
      <div class="w-10 h-10 rounded-xl bg-emerald-500/10 text-emerald-400 flex items-center justify-center">
        <i data-lucide="users" class="w-5 h-5"></i>
      </div>
    </div>
    <div class="flex items-baseline space-x-2">
      <span class="text-3xl font-extrabold text-white"><%= telemetry.totalStudents.toLocaleString() %></span>
      <span class="text-xs text-emerald-400 font-medium">Enrolled</span>
    </div>
    <p class="text-[11px] text-slate-400 mt-2">Across all tenant databases</p>
  </div>

  <!-- Total Staff / Faculty -->
  <div class="glass-card rounded-2xl p-5 sm:p-6 border border-slate-800">
    <div class="flex items-center justify-between mb-3">
      <span class="text-xs font-semibold uppercase tracking-wider text-slate-400">Teachers & Staff</span>
      <div class="w-10 h-10 rounded-xl bg-amber-500/10 text-amber-400 flex items-center justify-center">
        <i data-lucide="award" class="w-5 h-5"></i>
      </div>
    </div>
    <div class="flex items-baseline space-x-2">
      <span class="text-3xl font-extrabold text-white"><%= telemetry.totalStaff.toLocaleString() %></span>
      <span class="text-xs text-amber-400 font-medium">Active</span>
    </div>
    <p class="text-[11px] text-slate-400 mt-2">Faculty across all campuses</p>
  </div>

  <!-- Total Collections -->
  <div class="glass-card rounded-2xl p-5 sm:p-6 border border-slate-800">
    <div class="flex items-center justify-between mb-3">
      <span class="text-xs font-semibold uppercase tracking-wider text-slate-400">Fleet Collections</span>
      <div class="w-10 h-10 rounded-xl bg-purple-500/10 text-purple-400 flex items-center justify-center">
        <i data-lucide="circle-dollar-sign" class="w-5 h-5"></i>
      </div>
    </div>
    <div class="flex items-baseline space-x-2">
      <span class="text-3xl font-extrabold text-white">$<%= telemetry.totalCollected.toLocaleString() %></span>
      <span class="text-xs text-purple-400 font-medium">Aggregated</span>
    </div>
    <p class="text-[11px] text-slate-400 mt-2">Real-time payment ledger</p>
  </div>
</div>

<!-- Host & Node Infrastructure Telemetry Widget -->
<% if (typeof hostTelemetry !== 'undefined' && hostTelemetry) { %>
<div class="glass-card rounded-2xl p-5 sm:p-6 border border-slate-800 mb-8 shadow-xl">
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mb-5 border-b border-slate-800/80 pb-3">
    <div class="flex items-center space-x-2.5">
      <div class="w-8 h-8 rounded-lg bg-indigo-500/10 text-indigo-400 flex items-center justify-center">
        <i data-lucide="server" class="w-4 h-4"></i>
      </div>
      <div>
        <h3 class="text-sm font-bold text-white tracking-tight">Host Infrastructure Telemetry</h3>
        <p class="text-[11px] text-slate-400">Live compute, memory load & active MySQL connections</p>
      </div>
    </div>
    <div class="flex items-center space-x-3 text-xs">
      <span class="px-2.5 py-1 rounded-full bg-slate-800 text-slate-300 font-mono text-[11px]">
        Uptime: <strong class="text-emerald-400"><%= hostTelemetry.uptimeHours %> hrs</strong>
      </span>
      <span class="px-2.5 py-1 rounded-full bg-indigo-500/10 text-indigo-300 font-mono text-[11px] border border-indigo-500/20">
        Heap: <%= hostTelemetry.processHeapMb %> MB
      </span>
    </div>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
    <!-- CPU Load -->
    <div class="bg-slate-900/60 p-4 rounded-xl border border-slate-800/80">
      <div class="flex items-center justify-between text-xs mb-2">
        <span class="text-slate-400 font-medium">CPU Load (<%= hostTelemetry.cpuCores %> Cores)</span>
        <span class="font-bold font-mono <%= hostTelemetry.cpuLoadPct > 80 ? 'text-rose-400' : (hostTelemetry.cpuLoadPct > 60 ? 'text-amber-400' : 'text-emerald-400') %>">
          <%= hostTelemetry.cpuLoadPct %>%
        </span>
      </div>
      <div class="w-full bg-slate-800 h-2 rounded-full overflow-hidden">
        <div class="h-full rounded-full transition-all duration-500 <%= hostTelemetry.cpuLoadPct > 80 ? 'bg-rose-500' : (hostTelemetry.cpuLoadPct > 60 ? 'bg-amber-500' : 'bg-emerald-500') %>" style="width: <%= hostTelemetry.cpuLoadPct %>%"></div>
      </div>
    </div>

    <!-- RAM Usage -->
    <div class="bg-slate-900/60 p-4 rounded-xl border border-slate-800/80">
      <div class="flex items-center justify-between text-xs mb-2">
        <span class="text-slate-400 font-medium">Memory (<%= hostTelemetry.usedMemGb %> / <%= hostTelemetry.totalMemGb %> GB)</span>
        <span class="font-bold font-mono text-indigo-400"><%= hostTelemetry.memUsagePct %>%</span>
      </div>
      <div class="w-full bg-slate-800 h-2 rounded-full overflow-hidden">
        <div class="h-full bg-indigo-500 rounded-full transition-all duration-500" style="width: <%= hostTelemetry.memUsagePct %>%"></div>
      </div>
    </div>

    <!-- MySQL Active Threads -->
    <div class="bg-slate-900/60 p-4 rounded-xl border border-slate-800/80">
      <div class="flex items-center justify-between text-xs mb-2">
        <span class="text-slate-400 font-medium">MySQL Threads Connected</span>
        <span class="font-bold font-mono text-emerald-400"><%= hostTelemetry.mysqlThreads %> Active</span>
      </div>
      <div class="text-[11px] text-slate-500 flex items-center space-x-1.5">
        <i data-lucide="database" class="w-3.5 h-3.5 text-slate-400"></i>
        <span>Multi-database pooling enabled</span>
      </div>
    </div>

    <!-- Network Health Pulse -->
    <div class="bg-slate-900/60 p-4 rounded-xl border border-slate-800/80">
      <div class="flex items-center justify-between text-xs mb-2">
        <span class="text-slate-400 font-medium">Fleet Mesh Status</span>
        <span class="font-bold font-mono text-emerald-400 flex items-center space-x-1">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping inline-block"></span>
          <span>ONLINE</span>
        </span>
      </div>
      <div class="text-[11px] text-slate-500 flex items-center space-x-1.5">
        <i data-lucide="activity" class="w-3.5 h-3.5 text-slate-400"></i>
        <span>Caddy Reverse Proxy OK</span>
      </div>
    </div>
  </div>
</div>
<% } %>

<!-- Interactive ApexCharts Analytics Grid -->
<div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8">
  <!-- Chart 1: Monthly Collections Trend -->
  <div class="glass-card rounded-2xl p-5 sm:p-6 border border-slate-800">
    <div class="flex items-center justify-between mb-4">
      <div>
        <h3 class="text-sm font-bold text-white tracking-tight flex items-center space-x-2">
          <i data-lucide="trending-up" class="w-4 h-4 text-emerald-400"></i>
          <span>Monthly Revenue & Fee Collections</span>
        </h3>
        <p class="text-[11px] text-slate-400">6-Month fleet trajectory across all schools</p>
      </div>
      <span class="text-xs font-semibold px-2.5 py-1 rounded-lg bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
        +28.4% Growth
      </span>
    </div>
    <div id="chart-revenue" class="h-64 w-full"></div>
  </div>

  <!-- Chart 2: Student Enrollment Distribution -->
  <div class="glass-card rounded-2xl p-5 sm:p-6 border border-slate-800">
    <div class="flex items-center justify-between mb-4">
      <div>
        <h3 class="text-sm font-bold text-white tracking-tight flex items-center space-x-2">
          <i data-lucide="bar-chart-3" class="w-4 h-4 text-indigo-400"></i>
          <span>Active Enrollment by Campus</span>
        </h3>
        <p class="text-[11px] text-slate-400">Student census per isolated tenant instance</p>
      </div>
      <span class="text-xs font-semibold px-2.5 py-1 rounded-lg bg-indigo-500/10 text-indigo-400 border border-indigo-500/20">
        <%= telemetry.schools.length %> Schools
      </span>
    </div>
    <div id="chart-enrollment" class="h-64 w-full"></div>
  </div>
</div>

<!-- Active Schools Fleet Grid -->
<div class="mb-8">
  <div class="flex items-center justify-between mb-5">
    <div>
      <h2 class="text-lg font-bold text-white tracking-tight flex items-center space-x-2">
        <i data-lucide="layers" class="w-5 h-5 text-indigo-400"></i>
        <span>Active School Fleet</span>
      </h2>
      <p class="text-xs text-slate-400">Manage tenant instances, trigger 1-click SSO, and download backups</p>
    </div>
    <a href="/schools" class="text-xs text-indigo-400 hover:text-indigo-300 font-semibold flex items-center space-x-1">
      <span>View All Instances</span>
      <i data-lucide="arrow-right" class="w-3.5 h-3.5"></i>
    </a>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
    <% telemetry.schools.forEach(function(s) { %>
      <div class="glass-card rounded-2xl p-5 border border-slate-800 hover:border-slate-700 transition flex flex-col justify-between group">
        <div>
          <!-- Card Header -->
          <div class="flex items-start justify-between mb-4">
            <div class="flex items-center space-x-3">
              <div class="w-11 h-11 rounded-xl bg-indigo-600/10 text-indigo-400 border border-indigo-500/20 flex items-center justify-center font-bold">
                <i data-lucide="school" class="w-5 h-5"></i>
              </div>
              <div class="min-w-0">
                <h3 class="text-sm font-bold text-white truncate group-hover:text-indigo-300 transition"><%= s.name %></h3>
                <a href="https://<%= s.customDomain || s.subdomain %>" target="_blank" class="text-[11px] text-slate-400 font-mono hover:text-emerald-400 flex items-center space-x-1 truncate mt-0.5">
                  <span class="truncate"><%= s.subdomain %></span>
                  <i data-lucide="external-link" class="w-3 h-3 shrink-0"></i>
                </a>
              </div>
            </div>

            <!-- Health Status Badge -->
            <div>
              <% if (s.status === 'active') { %>
                <span class="inline-flex items-center space-x-1.5 px-2.5 py-1 rounded-full text-[11px] font-semibold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                  <span>Active</span>
                </span>
              <% } else if (s.status === 'suspended') { %>
                <span class="inline-flex items-center space-x-1.5 px-2.5 py-1 rounded-full text-[11px] font-semibold bg-amber-500/10 text-amber-400 border border-amber-500/20">
                  <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span>
                  <span>Suspended</span>
                </span>
              <% } else { %>
                <span class="inline-flex items-center space-x-1.5 px-2.5 py-1 rounded-full text-[11px] font-semibold bg-slate-500/10 text-slate-400 border border-slate-500/20">
                  <span class="w-1.5 h-1.5 rounded-full bg-slate-400"></span>
                  <span>Stopped</span>
                </span>
              <% } %>
            </div>
          </div>

          <!-- Quick Stats Row -->
          <div class="grid grid-cols-3 gap-2 p-3 bg-slate-900/80 rounded-xl mb-4 text-center border border-slate-800/80">
            <div>
              <span class="text-slate-400 block text-[10px] uppercase font-semibold">Students</span>
              <span class="font-bold text-white text-xs sm:text-sm"><%= s.studentsCount %></span>
            </div>
            <div>
              <span class="text-slate-400 block text-[10px] uppercase font-semibold">Faculty</span>
              <span class="font-bold text-white text-xs sm:text-sm"><%= s.staffCount %></span>
            </div>
            <div>
              <span class="text-slate-400 block text-[10px] uppercase font-semibold">Fees</span>
              <span class="font-bold text-emerald-400 text-xs sm:text-sm">$<%= s.totalFeesCollected.toLocaleString() %></span>
            </div>
          </div>
        </div>

        <!-- Action Buttons -->
        <div class="flex items-center space-x-2 pt-2 border-t border-slate-800/60">
          <a href="/schools/<%= s.schoolId %>/sso-login" target="_blank" title="Login as Super Admin" class="flex-1 py-2 px-3 bg-indigo-600 hover:bg-indigo-500 text-white rounded-xl text-xs font-semibold text-center shadow-md shadow-indigo-600/20 transition flex items-center justify-center space-x-1.5">
            <i data-lucide="zap" class="w-3.5 h-3.5"></i>
            <span>SSO Login</span>
          </a>
          <a href="/schools/<%= s.schoolId %>/backup-db" title="Download SQL Dump" class="p-2 bg-slate-800 hover:bg-slate-700 text-slate-300 rounded-xl text-xs border border-slate-700 transition" aria-label="Download Backup">
            <i data-lucide="database" class="w-4 h-4"></i>
          </a>
          <a href="/schools/<%= s.schoolId %>" class="py-2 px-3 bg-slate-800 hover:bg-slate-700 text-slate-300 rounded-xl text-xs font-medium border border-slate-700 transition">
            Manage
          </a>
        </div>
      </div>
    <% }); %>
  </div>
</div>

<!-- ApexCharts Script Initialization -->
<script>
  document.addEventListener('DOMContentLoaded', function () {
    // 1. Revenue Area Chart
    <% 
      const trendMonths = (typeof monthlyTrends !== 'undefined' && monthlyTrends.months) ? monthlyTrends.months : ['May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct'];
      const trendCollections = (typeof monthlyTrends !== 'undefined' && monthlyTrends.collections) ? monthlyTrends.collections : [35000, 48000, 62000, 71000, 89000, 114000];
      const schoolNames = telemetry.schools.map(s => s.name);
      const studentCounts = telemetry.schools.map(s => s.studentsCount);
    %>

    const revenueOptions = {
      series: [{
        name: 'Collections ($)',
        data: <%- JSON.stringify(trendCollections) %>
      }],
      chart: {
        type: 'area',
        height: 250,
        toolbar: { show: false },
        background: 'transparent'
      },
      colors: ['#10b981'],
      dataLabels: { enabled: false },
      stroke: { curve: 'smooth', width: 2 },
      fill: {
        type: 'gradient',
        gradient: {
          shadeIntensity: 1,
          opacityFrom: 0.45,
          opacityTo: 0.05,
          stops: [20, 100]
        }
      },
      grid: {
        borderColor: '#1e293b',
        strokeDashArray: 3
      },
      xaxis: {
        categories: <%- JSON.stringify(trendMonths) %>,
        labels: { style: { colors: '#94a3b8', fontSize: '11px' } },
        axisBorder: { color: '#334155' },
        axisTicks: { color: '#334155' }
      },
      yaxis: {
        labels: {
          style: { colors: '#94a3b8', fontSize: '11px' },
          formatter: function (val) { return '$' + (val / 1000).toFixed(0) + 'k'; }
        }
      },
      theme: { mode: 'dark' },
      tooltip: {
        theme: 'dark',
        y: { formatter: function (val) { return '$' + Number(val).toLocaleString(); } }
      }
    };

    const revChartEl = document.querySelector("#chart-revenue");
    if (revChartEl) {
      const revChart = new ApexCharts(revChartEl, revenueOptions);
      revChart.render();
    }

    // 2. Enrollment Bar Chart
    const enrollmentOptions = {
      series: [{
        name: 'Enrolled Students',
        data: <%- JSON.stringify(studentCounts) %>
      }],
      chart: {
        type: 'bar',
        height: 250,
        toolbar: { show: false },
        background: 'transparent'
      },
      colors: ['#6366f1'],
      plotOptions: {
        bar: {
          borderRadius: 6,
          columnWidth: '40%',
          distributed: false
        }
      },
      dataLabels: { enabled: false },
      grid: {
        borderColor: '#1e293b',
        strokeDashArray: 3
      },
      xaxis: {
        categories: <%- JSON.stringify(schoolNames) %>,
        labels: {
          style: { colors: '#94a3b8', fontSize: '11px' },
          rotate: -20,
          trim: true,
          maxHeight: 60
        },
        axisBorder: { color: '#334155' },
        axisTicks: { color: '#334155' }
      },
      yaxis: {
        labels: {
          style: { colors: '#94a3b8', fontSize: '11px' },
          formatter: function (val) { return Number(val).toLocaleString(); }
        }
      },
      theme: { mode: 'dark' },
      tooltip: {
        theme: 'dark',
        y: { formatter: function (val) { return Number(val).toLocaleString() + ' Students'; } }
      }
    };

    const enrChartEl = document.querySelector("#chart-enrollment");
    if (enrChartEl) {
      const enrChart = new ApexCharts(enrChartEl, enrollmentOptions);
      enrChart.render();
    }
  });
</script>

<%- include('partials/footer') %>
