<%- include('partials/header') %>

<!-- Top Hero / Command Action Bar -->
<div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-6">
  <div>
    <h1 class="text-xl sm:text-2xl font-bold text-white tracking-tight">Fleet Command Overview</h1>
    <p class="text-slate-400 text-xs sm:text-sm mt-0.5">Multi-tenant education cloud • Isolated databases • Fleet observability</p>
  </div>
  <div class="flex flex-wrap items-center gap-2">
    <a href="/schools/export/csv" class="btn-control btn-control-secondary">
      <i data-lucide="download" class="w-3.5 h-3.5 text-slate-400"></i>
      <span>Export CSV</span>
    </a>
    <a href="/master-data" class="btn-control btn-control-secondary">
      <i data-lucide="search" class="w-3.5 h-3.5 text-slate-400"></i>
      <span>Cross-School Search</span>
    </a>
    <a href="/schools/new" class="btn-control btn-control-primary">
      <i data-lucide="plus" class="w-3.5 h-3.5"></i>
      <span>Onboard New School</span>
    </a>
  </div>
</div>

<!-- Key Telemetry 4-Metric Grid -->
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
  <!-- Total Schools -->
  <div class="control-surface p-5">
    <div class="flex items-center justify-between text-xs text-slate-400 mb-2">
      <span class="font-medium">Total Schools</span>
      <i data-lucide="school" class="w-4 h-4 text-slate-400"></i>
    </div>
    <div class="flex items-baseline space-x-2">
      <span class="text-2xl sm:text-3xl font-bold text-white num-tabular"><%= telemetry.schools.length %></span>
      <span class="text-[11px] text-emerald-400 font-medium bg-emerald-500/10 px-2 py-0.5 rounded border border-emerald-500/20">100% Isolated</span>
    </div>
    <p class="text-[11px] text-slate-400 mt-2">Active instances across all networks</p>
  </div>

  <!-- Total Students -->
  <div class="control-surface p-5">
    <div class="flex items-center justify-between text-xs text-slate-400 mb-2">
      <span class="font-medium">Enrolled Students</span>
      <i data-lucide="users" class="w-4 h-4 text-slate-400"></i>
    </div>
    <div class="flex items-baseline space-x-2">
      <span class="text-2xl sm:text-3xl font-bold text-white num-tabular"><%= telemetry.totalStudents.toLocaleString() %></span>
      <span class="text-[11px] text-emerald-400 font-medium">Enrolled</span>
    </div>
    <p class="text-[11px] text-slate-400 mt-2">Aggregated across tenant databases</p>
  </div>

  <!-- Total Staff / Faculty -->
  <div class="control-surface p-5">
    <div class="flex items-center justify-between text-xs text-slate-400 mb-2">
      <span class="font-medium">Faculty &amp; Staff</span>
      <i data-lucide="award" class="w-4 h-4 text-slate-400"></i>
    </div>
    <div class="flex items-baseline space-x-2">
      <span class="text-2xl sm:text-3xl font-bold text-white num-tabular"><%= telemetry.totalStaff.toLocaleString() %></span>
      <span class="text-[11px] text-indigo-400 font-medium">Active</span>
    </div>
    <p class="text-[11px] text-slate-400 mt-2">Faculty across all campuses</p>
  </div>

  <!-- Total Collections -->
  <div class="control-surface p-5">
    <div class="flex items-center justify-between text-xs text-slate-400 mb-2">
      <span class="font-medium">Fleet Fee Collections</span>
      <i data-lucide="circle-dollar-sign" class="w-4 h-4 text-slate-400"></i>
    </div>
    <div class="flex items-baseline space-x-2">
      <span class="text-2xl sm:text-3xl font-bold text-emerald-400 num-tabular">₹<%= telemetry.totalCollected.toLocaleString('en-IN') %></span>
      <span class="text-[11px] text-slate-400 font-medium">INR</span>
    </div>
    <p class="text-[11px] text-slate-400 mt-2">Aggregated payment ledger</p>
  </div>
</div>

<!-- Host & Node Infrastructure Telemetry -->
<% if (typeof hostTelemetry !== 'undefined' && hostTelemetry) { %>
<div class="control-surface p-5 mb-6">
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mb-4 pb-3 border-b border-slate-800">
    <div class="flex items-center space-x-2">
      <i data-lucide="server" class="w-4 h-4 text-indigo-400"></i>
      <h2 class="text-sm font-semibold text-white tracking-tight">Host Infrastructure Telemetry</h2>
    </div>
    <div class="flex items-center space-x-3 text-xs text-slate-400">
      <span class="font-mono text-[11px]">
        Uptime: <strong class="text-emerald-400 num-tabular"><%= hostTelemetry.uptimeHours %> hrs</strong>
      </span>
      <span class="font-mono text-[11px]">
        Heap: <strong class="text-slate-300 num-tabular"><%= hostTelemetry.processHeapMb %> MB</strong>
      </span>
    </div>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 text-xs">
    <!-- CPU Load -->
    <div class="p-3 bg-slate-900/60 rounded-lg border border-slate-800">
      <div class="flex items-center justify-between mb-1.5">
        <span class="text-slate-400">CPU Load (<%= hostTelemetry.cpuCores %> Cores)</span>
        <span class="font-mono font-bold num-tabular <%= hostTelemetry.cpuLoadPct > 80 ? 'text-rose-400' : (hostTelemetry.cpuLoadPct > 60 ? 'text-amber-400' : 'text-emerald-400') %>">
          <%= hostTelemetry.cpuLoadPct %>%
        </span>
      </div>
      <div class="w-full bg-slate-800 h-1.5 rounded-full overflow-hidden">
        <div class="h-full rounded-full <%= hostTelemetry.cpuLoadPct > 80 ? 'bg-rose-500' : (hostTelemetry.cpuLoadPct > 60 ? 'bg-amber-500' : 'bg-emerald-500') %>" style="width: <%= hostTelemetry.cpuLoadPct %>%"></div>
      </div>
    </div>

    <!-- RAM Usage -->
    <div class="p-3 bg-slate-900/60 rounded-lg border border-slate-800">
      <div class="flex items-center justify-between mb-1.5">
        <span class="text-slate-400">Memory (<%= hostTelemetry.usedMemGb %> / <%= hostTelemetry.totalMemGb %> GB)</span>
        <span class="font-mono font-bold text-indigo-400 num-tabular"><%= hostTelemetry.memUsagePct %>%</span>
      </div>
      <div class="w-full bg-slate-800 h-1.5 rounded-full overflow-hidden">
        <div class="h-full bg-indigo-500 rounded-full" style="width: <%= hostTelemetry.memUsagePct %>%"></div>
      </div>
    </div>

    <!-- MySQL Active Threads -->
    <div class="p-3 bg-slate-900/60 rounded-lg border border-slate-800">
      <div class="flex items-center justify-between mb-1">
        <span class="text-slate-400">MySQL Connection Pool</span>
        <span class="font-mono font-bold text-emerald-400 num-tabular"><%= hostTelemetry.mysqlThreads %> Active</span>
      </div>
      <p class="text-[11px] text-slate-500">Multi-database pooling active</p>
    </div>

    <!-- Network Health Status -->
    <div class="p-3 bg-slate-900/60 rounded-lg border border-slate-800">
      <div class="flex items-center justify-between mb-1">
        <span class="text-slate-400">Fleet Mesh Gateway</span>
        <span class="font-mono font-bold text-emerald-400">Operational</span>
      </div>
      <p class="text-[11px] text-slate-500">Caddy on-demand reverse proxy</p>
    </div>
  </div>
</div>
<% } %>

<!-- Interactive ApexCharts Analytics Grid -->
<div class="grid grid-cols-1 lg:grid-cols-2 gap-5 mb-6">
  <!-- Chart 1: Monthly Collections Trend -->
  <div class="control-surface p-5">
    <div class="flex items-center justify-between mb-3 pb-2 border-b border-slate-800">
      <div>
        <h3 class="text-xs font-semibold text-white tracking-tight flex items-center space-x-2">
          <i data-lucide="trending-up" class="w-3.5 h-3.5 text-emerald-400"></i>
          <span>Monthly Revenue &amp; Fee Collections</span>
        </h3>
        <p class="text-[11px] text-slate-400">6-Month trajectory across all school databases</p>
      </div>
      <span class="text-[11px] font-medium text-emerald-400 bg-emerald-500/10 px-2 py-0.5 rounded border border-emerald-500/20">
        Active Trajectory
      </span>
    </div>
    <div id="chart-revenue" class="h-60 w-full"></div>
  </div>

  <!-- Chart 2: Student Enrollment Distribution -->
  <div class="control-surface p-5">
    <div class="flex items-center justify-between mb-3 pb-2 border-b border-slate-800">
      <div>
        <h3 class="text-xs font-semibold text-white tracking-tight flex items-center space-x-2">
          <i data-lucide="bar-chart-2" class="w-3.5 h-3.5 text-indigo-400"></i>
          <span>Active Enrollment by Campus</span>
        </h3>
        <p class="text-[11px] text-slate-400">Student census per isolated tenant instance</p>
      </div>
      <span class="text-[11px] font-medium text-slate-400">
        <%= telemetry.schools.length %> Instances
      </span>
    </div>
    <div id="chart-enrollment" class="h-60 w-full"></div>
  </div>
</div>

<!-- Active Schools Fleet Surface with Dual View (Table & Grid) -->
<div 
  x-data="{ 
    viewMode: 'table',
    fleetSearch: '',
    matchesSearch(name, subdomain, slug) {
      if (!this.fleetSearch.trim()) return true;
      const q = this.fleetSearch.toLowerCase();
      return (name || '').toLowerCase().includes(q) || 
             (subdomain || '').toLowerCase().includes(q) || 
             (slug || '').toLowerCase().includes(q);
    }
  }" 
  class="control-surface p-5 mb-6"
>
  <!-- Surface Header & View Switcher -->
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mb-4 pb-3 border-b border-slate-800">
    <div>
      <h2 class="text-sm font-bold text-white tracking-tight flex items-center space-x-2">
        <i data-lucide="layers" class="w-4 h-4 text-indigo-400"></i>
        <span>Active School Fleet</span>
      </h2>
      <p class="text-xs text-slate-400">Manage tenant instances, trigger 1-click SSO, and download backups</p>
    </div>

    <div class="flex items-center space-x-3">
      <!-- Search Filter -->
      <div class="relative">
        <i data-lucide="search" class="w-3.5 h-3.5 absolute left-2.5 top-1/2 -translate-y-1/2 text-slate-400"></i>
        <input 
          type="text" 
          x-model="fleetSearch" 
          placeholder="Filter fleet..." 
          class="pl-8 pr-3 py-1.5 text-xs bg-slate-900 border border-slate-800 rounded-lg text-white placeholder-slate-500 focus:outline-none focus:border-indigo-500 transition w-36 sm:w-48"
        >
      </div>

      <!-- View Switcher Toggle -->
      <div class="flex items-center bg-slate-900 p-0.5 rounded-lg border border-slate-800 text-xs">
        <button 
          @click="viewMode = 'table'" 
          :class="viewMode === 'table' ? 'bg-indigo-600 text-white shadow-sm' : 'text-slate-400 hover:text-white'"
          class="px-2.5 py-1 rounded-md font-medium transition flex items-center space-x-1"
          title="Dense Table View"
        >
          <i data-lucide="list" class="w-3.5 h-3.5"></i>
          <span class="hidden sm:inline">Table</span>
        </button>
        <button 
          @click="viewMode = 'grid'" 
          :class="viewMode === 'grid' ? 'bg-indigo-600 text-white shadow-sm' : 'text-slate-400 hover:text-white'"
          class="px-2.5 py-1 rounded-md font-medium transition flex items-center space-x-1"
          title="Grid Card View"
        >
          <i data-lucide="grid" class="w-3.5 h-3.5"></i>
          <span class="hidden sm:inline">Cards</span>
        </button>
      </div>
    </div>
  </div>

  <!-- 1. Dense Operational Table View -->
  <div x-show="viewMode === 'table'" class="overflow-x-auto">
    <table class="table-dense">
      <thead>
        <tr>
          <th>School Instance</th>
          <th>Domain / Routing</th>
          <th>Status</th>
          <th class="text-right">Students</th>
          <th class="text-right">Faculty</th>
          <th class="text-right">Fees Collected</th>
          <th class="text-right">Operational Actions</th>
        </tr>
      </thead>
      <tbody>
        <% telemetry.schools.forEach(function(s) { %>
          <tr 
            x-show="matchesSearch('<%= s.name.replace(/'/g, "\\'") %>', '<%= s.subdomain %>', '<%= s.slug %>')"
            class="control-row"
          >
            <!-- School Name -->
            <td>
              <div class="font-semibold text-white"><%= s.name %></div>
              <div class="text-[11px] text-slate-400 font-mono"><%= s.slug %></div>
            </td>

            <!-- Routing Domain -->
            <td>
              <a 
                href="https://<%= s.customDomain || s.subdomain %>" 
                target="_blank" 
                class="font-mono text-indigo-400 hover:text-indigo-300 text-xs inline-flex items-center space-x-1"
              >
                <span><%= s.customDomain || s.subdomain %></span>
                <i data-lucide="external-link" class="w-3 h-3 text-slate-500"></i>
              </a>
            </td>

            <!-- Status -->
            <td>
              <% if (s.status === 'active') { %>
                <span class="inline-flex items-center space-x-1 px-2 py-0.5 rounded text-[11px] font-medium bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                  <span>Active</span>
                </span>
              <% } else if (s.status === 'suspended') { %>
                <span class="inline-flex items-center space-x-1 px-2 py-0.5 rounded text-[11px] font-medium bg-amber-500/10 text-amber-400 border border-amber-500/20">
                  <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span>
                  <span>Suspended</span>
                </span>
              <% } else { %>
                <span class="inline-flex items-center space-x-1 px-2 py-0.5 rounded text-[11px] font-medium bg-slate-500/10 text-slate-400 border border-slate-500/20">
                  <span class="w-1.5 h-1.5 rounded-full bg-slate-400"></span>
                  <span>Stopped</span>
                </span>
              <% } %>
            </td>

            <!-- Students -->
            <td class="text-right font-semibold text-white num-tabular">
              <%= s.studentsCount.toLocaleString() %>
            </td>

            <!-- Staff -->
            <td class="text-right font-medium text-slate-300 num-tabular">
              <%= s.staffCount.toLocaleString() %>
            </td>

            <!-- Fees -->
            <td class="text-right font-semibold text-emerald-400 num-tabular">
              ₹<%= s.totalFeesCollected.toLocaleString('en-IN') %>
            </td>

            <!-- Actions -->
            <td class="text-right">
              <div class="inline-flex items-center space-x-1.5">
                <a 
                  href="/schools/<%= s.schoolId %>/sso-login" 
                  target="_blank" 
                  title="One-Click Super Admin Login" 
                  class="btn-control btn-control-primary"
                  style="height: 28px; padding: 0 8px; font-size: 11px;"
                >
                  <i data-lucide="zap" class="w-3 h-3"></i>
                  <span>SSO</span>
                </a>
                <a 
                  href="/schools/<%= s.schoolId %>/backup-db" 
                  title="Download SQL Backup Dump" 
                  class="btn-control btn-control-secondary"
                  style="height: 28px; padding: 0 8px; font-size: 11px;"
                  aria-label="Download Backup"
                >
                  <i data-lucide="database" class="w-3 h-3"></i>
                </a>
                <a 
                  href="/schools/<%= s.schoolId %>" 
                  class="btn-control btn-control-secondary"
                  style="height: 28px; padding: 0 8px; font-size: 11px;"
                >
                  Manage
                </a>
              </div>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>

  <!-- 2. Visual Card View (Fallback Switch) -->
  <div x-show="viewMode === 'grid'" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4" style="display: none;">
    <% telemetry.schools.forEach(function(s) { %>
      <div 
        x-show="matchesSearch('<%= s.name.replace(/'/g, "\\'") %>', '<%= s.subdomain %>', '<%= s.slug %>')"
        class="p-4 bg-slate-900/60 rounded-xl border border-slate-800 hover:border-slate-700 transition flex flex-col justify-between"
      >
        <div>
          <!-- Header -->
          <div class="flex items-start justify-between mb-3">
            <div>
              <h3 class="text-sm font-bold text-white"><%= s.name %></h3>
              <a href="https://<%= s.customDomain || s.subdomain %>" target="_blank" class="text-xs text-indigo-400 font-mono hover:underline flex items-center space-x-1 mt-0.5">
                <span><%= s.subdomain %></span>
                <i data-lucide="external-link" class="w-3 h-3"></i>
              </a>
            </div>

            <div>
              <% if (s.status === 'active') { %>
                <span class="inline-flex items-center space-x-1 px-2 py-0.5 rounded text-[11px] font-medium bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                  <span>Active</span>
                </span>
              <% } else { %>
                <span class="inline-flex items-center space-x-1 px-2 py-0.5 rounded text-[11px] font-medium bg-amber-500/10 text-amber-400 border border-amber-500/20">
                  <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span>
                  <span><%= s.status %></span>
                </span>
              <% } %>
            </div>
          </div>

          <!-- Quick Metrics -->
          <div class="grid grid-cols-3 gap-2 p-2.5 bg-slate-950/60 rounded-lg mb-3 text-center border border-slate-800">
            <div>
              <span class="text-slate-400 block text-[10px]">Students</span>
              <span class="font-bold text-white text-xs num-tabular"><%= s.studentsCount.toLocaleString() %></span>
            </div>
            <div>
              <span class="text-slate-400 block text-[10px]">Faculty</span>
              <span class="font-bold text-white text-xs num-tabular"><%= s.staffCount.toLocaleString() %></span>
            </div>
            <div>
              <span class="text-slate-400 block text-[10px]">Collections</span>
              <span class="font-bold text-emerald-400 text-xs num-tabular">₹<%= s.totalFeesCollected.toLocaleString('en-IN') %></span>
            </div>
          </div>
        </div>

        <!-- Action Controls -->
        <div class="flex items-center space-x-2 pt-2 border-t border-slate-800">
          <a href="/schools/<%= s.schoolId %>/sso-login" target="_blank" class="flex-1 btn-control btn-control-primary justify-center">
            <i data-lucide="zap" class="w-3.5 h-3.5"></i>
            <span>SSO Login</span>
          </a>
          <a href="/schools/<%= s.schoolId %>/backup-db" title="Download SQL Dump" class="btn-control btn-control-secondary" aria-label="Backup">
            <i data-lucide="database" class="w-3.5 h-3.5"></i>
          </a>
          <a href="/schools/<%= s.schoolId %>" class="btn-control btn-control-secondary">
            Manage
          </a>
        </div>
      </div>
    <% }); %>
  </div>
</div>

<!-- ApexCharts Script Initialization -->
<script>
  document.addEventListener('DOMContentLoaded', function () {
    <% 
      const trendMonths = (typeof monthlyTrends !== 'undefined' && monthlyTrends.months) ? monthlyTrends.months : ['May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct'];
      const trendCollections = (typeof monthlyTrends !== 'undefined' && monthlyTrends.collections) ? monthlyTrends.collections : [35000, 48000, 62000, 71000, 89000, 114000];
      const schoolNames = telemetry.schools.map(s => s.name);
      const studentCounts = telemetry.schools.map(s => s.studentsCount);
    %>

    // 1. Revenue Area Chart
    const revenueOptions = {
      series: [{
        name: 'Collections (₹)',
        data: <%- JSON.stringify(trendCollections) %>
      }],
      chart: {
        type: 'area',
        height: 240,
        toolbar: { show: false },
        background: 'transparent'
      },
      colors: ['#10b981'],
      dataLabels: { enabled: false },
      stroke: { curve: 'smooth', width: 2 },
      fill: {
        type: 'gradient',
        gradient: {
          shadeIntensity: 1,
          opacityFrom: 0.35,
          opacityTo: 0.05,
          stops: [20, 100]
        }
      },
      grid: {
        borderColor: '#1e293b',
        strokeDashArray: 3
      },
      xaxis: {
        categories: <%- JSON.stringify(trendMonths) %>,
        labels: { style: { colors: '#94a3b8', fontSize: '11px', fontFamily: 'var(--font-sans)' } },
        axisBorder: { color: '#334155' },
        axisTicks: { color: '#334155' }
      },
      yaxis: {
        labels: {
          style: { colors: '#94a3b8', fontSize: '11px', fontFamily: 'var(--font-sans)' },
          formatter: function (val) { return '₹' + (val / 1000).toFixed(0) + 'k'; }
        }
      },
      theme: { mode: 'dark' },
      tooltip: {
        theme: 'dark',
        y: { formatter: function (val) { return '₹' + Number(val).toLocaleString('en-IN'); } }
      }
    };

    const revChartEl = document.querySelector("#chart-revenue");
    if (revChartEl) {
      const revChart = new ApexCharts(revChartEl, revenueOptions);
      revChart.render();
    }

    // 2. Enrollment Bar Chart
    const enrollmentOptions = {
      series: [{
        name: 'Enrolled Students',
        data: <%- JSON.stringify(studentCounts) %>
      }],
      chart: {
        type: 'bar',
        height: 240,
        toolbar: { show: false },
        background: 'transparent'
      },
      colors: ['#6366f1'],
      plotOptions: {
        bar: {
          borderRadius: 4,
          columnWidth: '35%',
          distributed: false
        }
      },
      dataLabels: { enabled: false },
      grid: {
        borderColor: '#1e293b',
        strokeDashArray: 3
      },
      xaxis: {
        categories: <%- JSON.stringify(schoolNames) %>,
        labels: {
          style: { colors: '#94a3b8', fontSize: '11px', fontFamily: 'var(--font-sans)' },
          rotate: -20,
          trim: true,
          maxHeight: 60
        },
        axisBorder: { color: '#334155' },
        axisTicks: { color: '#334155' }
      },
      yaxis: {
        labels: {
          style: { colors: '#94a3b8', fontSize: '11px', fontFamily: 'var(--font-sans)' },
          formatter: function (val) { return Number(val).toLocaleString(); }
        }
      },
      theme: { mode: 'dark' },
      tooltip: {
        theme: 'dark',
        y: { formatter: function (val) { return Number(val).toLocaleString() + ' Students'; } }
      }
    };

    const enrChartEl = document.querySelector("#chart-enrollment");
    if (enrChartEl) {
      const enrChart = new ApexCharts(enrChartEl, enrollmentOptions);
      enrChart.render();
    }
  });
</script>

<%- include('partials/footer') %>
