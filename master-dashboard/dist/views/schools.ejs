<%- include('partials/header') %>

<!-- Flash Notifications -->
<% if (typeof success !== 'undefined' && success) { %>
  <div class="mb-6 p-4 rounded-2xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-xs flex items-center justify-between shadow-lg shadow-emerald-500/5">
    <div class="flex items-center space-x-2">
      <span class="text-base">✅</span>
      <span class="font-medium"><%= success %></span>
    </div>
    <a href="/schools" class="text-slate-400 hover:text-white text-[11px]">Dismiss</a>
  </div>
<% } %>

<% if (typeof error !== 'undefined' && error) { %>
  <div class="mb-6 p-4 rounded-2xl bg-rose-500/10 border border-rose-500/20 text-rose-400 text-xs flex items-center justify-between shadow-lg shadow-rose-500/5">
    <div class="flex items-center space-x-2">
      <span class="text-base">⚠️</span>
      <span class="font-medium"><%= error %></span>
    </div>
    <a href="/schools" class="text-slate-400 hover:text-white text-[11px]">Dismiss</a>
  </div>
<% } %>

<div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-8">
  <div>
    <h1 class="text-2xl font-extrabold text-white tracking-tight">School Fleet Directory</h1>
    <p class="text-slate-400 text-sm mt-1">
      Manage isolated school tenants, domains, and containers. Live cluster host: 
      <code class="text-indigo-400 font-mono text-xs bg-slate-900 px-2 py-0.5 rounded border border-slate-800"><%= typeof currentHost !== 'undefined' ? currentHost : 'Active' %></code>
    </p>
  </div>
  <a href="/schools/new" class="px-5 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-semibold shadow-lg shadow-indigo-600/25 transition flex items-center space-x-2 self-start sm:self-auto">
    <span>✨</span>
    <span>Onboard New School</span>
  </a>
</div>

<!-- Fleet Table -->
<div class="glass-card rounded-2xl border border-slate-800 overflow-hidden shadow-xl">
  <div class="overflow-x-auto">
    <table class="w-full text-left text-xs">
      <thead class="bg-slate-900/90 text-slate-400 font-semibold border-b border-slate-800 uppercase tracking-wider text-[11px]">
        <tr>
          <th class="px-6 py-4">School & Slug</th>
          <th class="px-6 py-4">Live Domain & URL</th>
          <th class="px-6 py-4">Database</th>
          <th class="px-6 py-4">Status</th>
          <th class="px-6 py-4">Quota</th>
          <th class="px-6 py-4 text-right">Actions</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-800/60">
        <% schools.forEach(function(s) { %>
          <tr class="hover:bg-slate-800/30 transition">
            <td class="px-6 py-4">
              <div class="flex items-center space-x-3">
                <div class="w-9 h-9 rounded-xl bg-indigo-500/10 text-indigo-400 flex items-center justify-center font-bold text-base">
                  🏫
                </div>
                <div>
                  <a href="/schools/<%= s.id %>" class="text-white font-bold hover:text-indigo-400 transition"><%= s.name %></a>
                  <p class="text-slate-400 font-mono text-[11px]">slug: <span class="text-indigo-400"><%= s.slug %></span></p>
                </div>
              </div>
            </td>

            <td class="px-6 py-4 font-mono text-slate-300">
              <a href="https://<%= s.customDomain || s.subdomain %>" target="_blank" class="hover:text-emerald-400 text-slate-200 flex items-center space-x-1 font-semibold" title="Open School Portal in New Tab">
                <span><%= s.subdomain %></span>
                <span class="text-[10px] text-slate-500">↗</span>
              </a>
              <% if (s.customDomain) { %>
                <div class="text-emerald-400 text-[11px] flex items-center space-x-1 mt-0.5 font-sans">
                  <span>🔗</span>
                  <span class="font-mono"><%= s.customDomain %></span>
                  <span class="text-[9px] px-1.5 py-0.2 rounded bg-emerald-500/10 border border-emerald-500/20 text-emerald-300">Custom</span>
                </div>
              <% } %>
            </td>

            <td class="px-6 py-4 font-mono text-slate-400">
              <%= s.dbName %>
            </td>

            <td class="px-6 py-4">
              <% if (s.status === 'active') { %>
                <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
                  ● Active
                </span>
              <% } else if (s.status === 'suspended') { %>
                <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold bg-amber-500/10 text-amber-400 border border-amber-500/20">
                  ● Suspended
                </span>
              <% } else { %>
                <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold bg-slate-500/10 text-slate-400 border border-slate-500/20">
                  ● Stopped
                </span>
              <% } %>
            </td>

            <td class="px-6 py-4 text-slate-300">
              <div><%= s.storageQuotaGb %> GB</div>
              <div class="text-[11px] text-slate-500"><%= s.maxStudents %> students</div>
            </td>

            <td class="px-6 py-4 text-right">
              <div class="flex items-center justify-end space-x-2">
                <!-- 1-Click Master SSO -->
                <a href="/schools/<%= s.id %>/sso-login" target="_blank" title="1-Click Super Admin Login" class="px-3 py-1.5 rounded-lg bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-semibold transition flex items-center space-x-1">
                  <span>⚡</span>
                  <span>Login</span>
                </a>
                <!-- SQL Backup Download -->
                <a href="/schools/<%= s.id %>/backup-db" title="Download SQL Backup" class="px-2.5 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs border border-slate-700 transition">
                  💾
                </a>
                <!-- Manage -->
                <a href="/schools/<%= s.id %>" class="px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs font-medium border border-slate-700 transition">
                  Manage
                </a>
              </div>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
</div>

<%- include('partials/footer') %>

