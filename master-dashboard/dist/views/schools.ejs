<%- include('partials/header') %>

<div x-data="{
  searchQuery: '',
  statusFilter: 'all',
  passwordModalOpen: false,
  selectedSchool: { id: '', name: '', slug: '', adminEmail: '' },
  newPassword: '',
  copied: false,
  selectedSchools: [],
  selectAll: false,

  toggleSelectAll(schoolIds) {
    if (this.selectAll) {
      this.selectedSchools = [...schoolIds];
    } else {
      this.selectedSchools = [];
    }
  },

  openPasswordModal(school) {
    this.selectedSchool = school;
    this.generateStrongPassword();
    this.passwordModalOpen = true;
  },
  generateStrongPassword() {
    const upper = 'ABCDEFGHJKLMNPQRSTUVWXYZ';
    const lower = 'abcdefghjkmnpqrstuvwxyz';
    const digits = '23456789';
    const symbols = '!@#$%^&*';
    const all = upper + lower + digits + symbols;
    let pwd = '';
    pwd += upper.charAt(Math.floor(Math.random() * upper.length));
    pwd += lower.charAt(Math.floor(Math.random() * lower.length));
    pwd += digits.charAt(Math.floor(Math.random() * digits.length));
    pwd += symbols.charAt(Math.floor(Math.random() * symbols.length));
    for (let i = 0; i < 8; i++) {
      pwd += all.charAt(Math.floor(Math.random() * all.length));
    }
    this.newPassword = pwd;
  },
  copyPassword() {
    navigator.clipboard.writeText(this.newPassword);
    this.copied = true;
    setTimeout(() => { this.copied = false; }, 2000);
  },
  matchesFilter(name, slug, domain, db, status) {
    const q = this.searchQuery.toLowerCase();
    const matchesSearch = !q || name.toLowerCase().includes(q) || slug.toLowerCase().includes(q) || domain.toLowerCase().includes(q) || db.toLowerCase().includes(q);
    const matchesStatus = this.statusFilter === 'all' || status === this.statusFilter;
    return matchesSearch && matchesStatus;
  }
}">

  <!-- Flash Notifications -->
  <% if (typeof success !== 'undefined' && success) { %>
    <div class="mb-5 p-3.5 rounded-lg bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-xs flex items-center justify-between">
      <div class="flex items-center space-x-2">
        <i data-lucide="check-circle" class="w-4 h-4 text-emerald-400"></i>
        <span class="font-medium"><%= success %></span>
      </div>
      <a href="/schools" class="text-slate-400 hover:text-white text-[11px]">Dismiss</a>
    </div>
  <% } %>

  <% if (typeof error !== 'undefined' && error) { %>
    <div class="mb-5 p-3.5 rounded-lg bg-rose-500/10 border border-rose-500/20 text-rose-400 text-xs flex items-center justify-between">
      <div class="flex items-center space-x-2">
        <i data-lucide="alert-triangle" class="w-4 h-4 text-rose-400"></i>
        <span class="font-medium"><%= error %></span>
      </div>
      <a href="/schools" class="text-slate-400 hover:text-white text-[11px]">Dismiss</a>
    </div>
  <% } %>

  <!-- Title & Primary Action Header -->
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-5">
    <div>
      <h1 class="text-xl sm:text-2xl font-bold text-white tracking-tight">School Fleet Directory</h1>
      <p class="text-slate-400 text-xs sm:text-sm mt-0.5">
        Multi-tenant instance management • Host: 
        <code class="text-indigo-400 font-mono text-xs bg-slate-900 px-1.5 py-0.5 rounded border border-slate-800"><%= typeof currentHost !== 'undefined' ? currentHost : 'Active' %></code>
      </p>
    </div>
    <div class="flex flex-wrap items-center gap-2">
      <a href="/schools/export/csv" class="btn-control btn-control-secondary">
        <i data-lucide="download" class="w-3.5 h-3.5 text-slate-400"></i>
        <span>Export CSV</span>
      </a>
      <a href="/schools/new" class="btn-control btn-control-primary">
        <i data-lucide="plus" class="w-3.5 h-3.5"></i>
        <span>Onboard New School</span>
      </a>
    </div>
  </div>

  <!-- Search & Filter Bar -->
  <div class="control-surface p-3 mb-5 flex flex-col md:flex-row md:items-center md:justify-between gap-3">
    <!-- Live Search Input -->
    <div class="relative flex-1">
      <i data-lucide="search" class="w-3.5 h-3.5 absolute left-3 top-1/2 -translate-y-1/2 text-slate-400"></i>
      <input 
        type="text" 
        x-model="searchQuery" 
        placeholder="Filter by school name, slug, domain, or database..."
        class="w-full pl-9 pr-3 py-1.5 rounded-lg bg-slate-900 border border-slate-800 text-xs text-white placeholder-slate-500 focus:outline-none focus:border-indigo-500 transition"
      >
      <button 
        x-show="searchQuery.length > 0" 
        @click="searchQuery = ''" 
        class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-white"
        style="display: none;"
      >
        <i data-lucide="x" class="w-3.5 h-3.5"></i>
      </button>
    </div>

    <!-- Status Filter Buttons -->
    <div class="flex items-center space-x-1.5 overflow-x-auto text-xs font-medium shrink-0">
      <button 
        @click="statusFilter = 'all'" 
        :class="statusFilter === 'all' ? 'bg-indigo-600 text-white' : 'bg-slate-900 text-slate-400 hover:text-white'"
        class="px-2.5 py-1 rounded-lg transition"
      >
        All (<%= schools.length %>)
      </button>
      <button 
        @click="statusFilter = 'active'" 
        :class="statusFilter === 'active' ? 'bg-emerald-600 text-white' : 'bg-slate-900 text-slate-400 hover:text-white'"
        class="px-2.5 py-1 rounded-lg transition"
      >
        Active (<%= activeCount %>)
      </button>
      <button 
        @click="statusFilter = 'suspended'" 
        :class="statusFilter === 'suspended' ? 'bg-amber-600 text-white' : 'bg-slate-900 text-slate-400 hover:text-white'"
        class="px-2.5 py-1 rounded-lg transition"
      >
        Suspended (<%= suspendedCount %>)
      </button>
      <button 
        @click="statusFilter = 'stopped'" 
        :class="statusFilter === 'stopped' ? 'bg-slate-700 text-white' : 'bg-slate-900 text-slate-400 hover:text-white'"
        class="px-2.5 py-1 rounded-lg transition"
      >
        Stopped (<%= schools.length - activeCount - suspendedCount %>)
      </button>
    </div>
  </div>

  <!-- Floating Batch Actions Toolbar -->
  <div 
    x-show="selectedSchools.length > 0" 
    x-transition:enter="transition ease-out duration-150"
    x-transition:enter-start="opacity-0 -translate-y-2"
    x-transition:enter-end="opacity-100 translate-y-0"
    class="mb-4 p-2.5 bg-indigo-950/80 border border-indigo-500/30 rounded-xl flex items-center justify-between text-xs shadow-lg"
    style="display: none;"
  >
    <div class="flex items-center space-x-2">
      <span class="font-bold text-white bg-indigo-600 px-2 py-0.5 rounded text-[11px]" x-text="selectedSchools.length"></span>
      <span class="text-indigo-200">instance(s) selected</span>
    </div>
    <div class="flex items-center space-x-2">
      <button 
        @click="alert('Batch backup initiated for ' + selectedSchools.length + ' instances. Preparing archive...')" 
        class="btn-control btn-control-primary"
        style="height: 28px; padding: 0 10px; font-size: 11px;"
      >
        <i data-lucide="archive" class="w-3 h-3"></i>
        <span>Backup Selected</span>
      </button>
      <button 
        @click="selectedSchools = []; selectAll = false" 
        class="text-indigo-300 hover:text-white text-xs px-2 py-1"
      >
        Clear selection
      </button>
    </div>
  </div>

  <!-- Responsive Fleet Table Wrapper -->
  <div class="control-surface overflow-hidden">
    <div class="overflow-x-auto">
      <table class="table-dense">
        <thead>
          <tr>
            <th style="width: 36px;">
              <input 
                type="checkbox" 
                x-model="selectAll" 
                @change="toggleSelectAll([<%= schools.map(s => `'${s.id}'`).join(',') %>])"
                class="rounded border-slate-700 bg-slate-900 text-indigo-600 focus:ring-0"
              >
            </th>
            <th>School Instance &amp; Slug</th>
            <th>Live Domain &amp; Routing</th>
            <th>Database</th>
            <th>Status</th>
            <th>Storage Quota</th>
            <th class="text-right">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% schools.forEach(function(s) { %>
            <tr 
              x-show="matchesFilter('<%= (s.name || '').replace(/'/g, "\\'") %>', '<%= s.slug %>', '<%= (s.customDomain || s.subdomain) %>', '<%= s.dbName %>', '<%= s.status %>')"
              class="control-row"
            >
              <!-- Checkbox -->
              <td>
                <input 
                  type="checkbox" 
                  value="<%= s.id %>" 
                  x-model="selectedSchools"
                  class="rounded border-slate-700 bg-slate-900 text-indigo-600 focus:ring-0"
                >
              </td>

              <!-- School & Slug -->
              <td>
                <div>
                  <a href="/schools/<%= s.id %>" class="text-white font-semibold hover:text-indigo-400 transition">
                    <%= s.name %>
                  </a>
                  <div class="text-[11px] text-slate-400 font-mono">slug: <%= s.slug %></div>
                </div>
              </td>

              <!-- Live Domain & URL -->
              <td class="font-mono text-slate-300">
                <a href="https://<%= s.customDomain || s.subdomain %>" target="_blank" class="hover:text-emerald-400 text-slate-200 inline-flex items-center space-x-1" title="Open School Portal">
                  <span><%= s.subdomain %></span>
                  <i data-lucide="external-link" class="w-3 h-3 text-slate-500"></i>
                </a>
                <% if (s.customDomain) { %>
                  <div class="text-emerald-400 text-[11px] flex items-center space-x-1 mt-0.5">
                    <i data-lucide="globe" class="w-3 h-3"></i>
                    <span><%= s.customDomain %></span>
                  </div>
                <% } %>
              </td>

              <!-- Database -->
              <td class="font-mono text-slate-400">
                <span><%= s.dbName %></span>
              </td>

              <!-- Status Badge -->
              <td>
                <% if (s.status === 'active') { %>
                  <span class="inline-flex items-center space-x-1 px-2 py-0.5 rounded text-[11px] font-medium bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                    <span>Active</span>
                  </span>
                <% } else if (s.status === 'suspended') { %>
                  <span class="inline-flex items-center space-x-1 px-2 py-0.5 rounded text-[11px] font-medium bg-amber-500/10 text-amber-400 border border-amber-500/20">
                    <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span>
                    <span>Suspended</span>
                  </span>
                <% } else { %>
                  <span class="inline-flex items-center space-x-1 px-2 py-0.5 rounded text-[11px] font-medium bg-slate-500/10 text-slate-400 border border-slate-500/20">
                    <span class="w-1.5 h-1.5 rounded-full bg-slate-400"></span>
                    <span>Stopped</span>
                  </span>
                <% } %>
              </td>

              <!-- Quota -->
              <td class="text-slate-300">
                <span class="font-semibold num-tabular"><%= s.storageQuotaGb %> GB</span>
                <span class="text-[11px] text-slate-500 block num-tabular"><%= s.maxStudents %> max students</span>
              </td>

              <!-- Actions Group -->
              <td class="text-right">
                <div class="inline-flex items-center space-x-1.5">
                  <!-- 1-Click Master SSO -->
                  <a 
                    href="/schools/<%= s.id %>/sso-login" 
                    target="_blank" 
                    title="1-Click Super Admin Login" 
                    class="btn-control btn-control-primary"
                    style="height: 28px; padding: 0 8px; font-size: 11px;"
                  >
                    <i data-lucide="zap" class="w-3 h-3"></i>
                    <span>SSO</span>
                  </a>

                  <!-- Quick Password Reset Trigger -->
                  <button 
                    type="button"
                    @click="openPasswordModal({ id: '<%= s.id %>', name: '<%= (s.name || '').replace(/'/g, "\\'") %>', slug: '<%= s.slug %>', adminEmail: '<%= s.adminEmail || 'admin' %>' })" 
                    title="Reset Admin Password"
                    class="btn-control btn-control-secondary"
                    style="height: 28px; padding: 0 8px; font-size: 11px;"
                    aria-label="Reset Password"
                  >
                    <i data-lucide="key" class="w-3 h-3"></i>
                  </button>

                  <!-- SQL Backup Download -->
                  <a 
                    href="/schools/<%= s.id %>/backup-db" 
                    title="Download SQL Backup Dump" 
                    class="btn-control btn-control-secondary"
                    style="height: 28px; padding: 0 8px; font-size: 11px;"
                    aria-label="Download Backup"
                  >
                    <i data-lucide="download" class="w-3 h-3"></i>
                  </a>

                  <!-- Manage Details -->
                  <a 
                    href="/schools/<%= s.id %>" 
                    class="btn-control btn-control-secondary"
                    style="height: 28px; padding: 0 8px; font-size: 11px;"
                  >
                    Manage
                  </a>
                </div>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Password Reset Modal Dialog -->
  <div 
    x-show="passwordModalOpen" 
    class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-950/80 backdrop-blur-sm"
    x-transition
    style="display: none;"
  >
    <div 
      @click.away="passwordModalOpen = false" 
      class="bg-slate-900 border border-slate-800 rounded-xl max-w-md w-full p-5 shadow-2xl relative"
    >
      <div class="flex items-center justify-between mb-4 pb-3 border-b border-slate-800">
        <div>
          <h3 class="text-sm font-bold text-white">Reset Super Admin Password</h3>
          <p class="text-[11px] text-slate-400" x-text="selectedSchool.name"></p>
        </div>
        <button @click="passwordModalOpen = false" class="text-slate-400 hover:text-white p-1 rounded-lg" aria-label="Close modal">
          <i data-lucide="x" class="w-4 h-4"></i>
        </button>
      </div>

      <form :action="'/schools/' + selectedSchool.id + '/reset-password'" method="POST" class="space-y-4">
        <div>
          <label class="block text-xs font-medium text-slate-300 mb-1">Target Admin Username / Email</label>
          <input 
            type="text" 
            :value="selectedSchool.adminEmail" 
            disabled 
            class="w-full px-3 py-1.5 rounded-lg bg-slate-950 border border-slate-800 text-xs font-mono text-slate-400 cursor-not-allowed"
          >
        </div>

        <div>
          <div class="flex items-center justify-between mb-1">
            <label class="text-xs font-medium text-slate-300">New Password</label>
            <button 
              type="button" 
              @click="generateStrongPassword()" 
              class="text-[11px] text-indigo-400 hover:text-indigo-300 font-medium flex items-center space-x-1"
            >
              <i data-lucide="refresh-cw" class="w-3 h-3"></i>
              <span>Regenerate</span>
            </button>
          </div>
          <div class="flex items-center space-x-2">
            <input 
              type="text" 
              name="newPassword" 
              x-model="newPassword" 
              required 
              minlength="6"
              class="flex-1 px-3 py-1.5 rounded-lg bg-slate-950 border border-slate-800 text-xs font-mono text-white focus:outline-none focus:border-indigo-500"
            >
            <button 
              type="button" 
              @click="copyPassword()" 
              class="btn-control btn-control-secondary"
              style="height: 32px;"
            >
              <i data-lucide="copy" class="w-3 h-3"></i>
              <span x-text="copied ? 'Copied' : 'Copy'"></span>
            </button>
          </div>
          <p class="text-[10px] text-slate-500 mt-1">This will overwrite the school admin password directly in the tenant database.</p>
        </div>

        <div class="flex items-center justify-end space-x-2 pt-3 border-t border-slate-800">
          <button 
            type="button" 
            @click="passwordModalOpen = false" 
            class="btn-control btn-control-secondary"
          >
            Cancel
          </button>
          <button 
            type="submit" 
            class="btn-control btn-control-primary"
            style="background-color: var(--status-warning);"
          >
            <i data-lucide="check" class="w-3.5 h-3.5"></i>
            <span>Confirm Reset</span>
          </button>
        </div>
      </form>
    </div>
  </div>

</div>

<%- include('partials/footer') %>
