<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof pageTitle !== 'undefined' ? pageTitle : 'Control Plane' %> | Prime School Fleet Master</title>
  <link rel="icon" type="image/png" href="/favicon.png">
  <link rel="stylesheet" href="/tokens.css">
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
  <script src="https://unpkg.com/lucide@latest"></script>
  <script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>
  <style>
    [x-cloak] { display: none !important; }
    .glass-card {
      background: rgba(15, 23, 42, 0.75);
      backdrop-filter: blur(12px);
      border: 1px solid rgba(255, 255, 255, 0.08);
    }
    .glass-card:hover {
      border-color: rgba(99, 102, 241, 0.25);
    }
  </style>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            brand: {
              50: '#eef2ff',
              100: '#e0e7ff',
              500: '#6366f1',
              600: '#4f46e5',
              700: '#4338ca',
            }
          }
        }
      }
    }
  </script>
</head>
<body 
  x-data="{ 
    mobileNavOpen: false, 
    commandPaletteOpen: false,
    paletteQuery: '',
    paletteItems: [
      { category: 'Navigation', title: 'Fleet Overview', url: '/', icon: 'layout-dashboard' },
      { category: 'Navigation', title: 'School Instances Directory', url: '/schools', icon: 'school' },
      { category: 'Navigation', title: 'Onboard New School', url: '/schools/new', icon: 'plus-circle' },
      { category: 'Navigation', title: 'Master Cross-School Data & Search', url: '/master-data', icon: 'database' },
      { category: 'Navigation', title: 'Networks & Custom Domains', url: '/networks', icon: 'network' },
      { category: 'Navigation', title: 'Operators & Access Control', url: '/users', icon: 'shield-check' },
      { category: 'Quick Actions', title: 'Export Full Fleet CSV', url: '/schools/export/csv', icon: 'download' },
      { category: 'Quick Actions', title: 'Verify Custom Domain DNS', url: '/networks', icon: 'globe' },
      { category: 'Account', title: 'Sign Out / Terminate Session', url: '/auth/logout', icon: 'log-out' }
    ],
    filteredPaletteItems() {
      const q = this.paletteQuery.trim().toLowerCase();
      if (!q) return this.paletteItems;
      return this.paletteItems.filter(item => 
        item.title.toLowerCase().includes(q) || 
        item.category.toLowerCase().includes(q) || 
        item.url.toLowerCase().includes(q)
      );
    }
  }"
  @keydown.window.prevent.cmd.k="commandPaletteOpen = true; $nextTick(() => $refs.paletteInput?.focus())"
  @keydown.window.prevent.ctrl.k="commandPaletteOpen = true; $nextTick(() => $refs.paletteInput?.focus())"
  @keydown.escape.window="commandPaletteOpen = false; mobileNavOpen = false"
  class="bg-[#090d16] text-slate-100 flex min-h-screen antialiased selection:bg-indigo-500 selection:text-white"
>

  <!-- Global Command Palette Modal (Cmd + K) -->
  <div 
    x-show="commandPaletteOpen" 
    x-transition:enter="transition ease-out duration-150"
    x-transition:enter-start="opacity-0"
    x-transition:enter-end="opacity-100"
    x-transition:leave="transition ease-in duration-100"
    x-transition:leave-start="opacity-100"
    x-transition:leave-end="opacity-0"
    class="fixed inset-0 z-50 flex items-start justify-center pt-16 sm:pt-24 px-4 bg-slate-950/80 backdrop-blur-md"
    x-cloak
  >
    <div 
      @click.away="commandPaletteOpen = false" 
      x-transition:enter="transition ease-out duration-150"
      x-transition:enter-start="opacity-0 scale-95"
      x-transition:enter-end="opacity-100 scale-100"
      x-transition:leave="transition ease-in duration-100"
      x-transition:leave-start="opacity-100 scale-100"
      x-transition:leave-end="opacity-0 scale-95"
      class="w-full max-w-xl bg-slate-900 border border-slate-700/80 rounded-2xl shadow-2xl overflow-hidden"
    >
      <!-- Command Input -->
      <div class="relative flex items-center border-b border-slate-800 px-4 py-3.5">
        <i data-lucide="search" class="w-4 h-4 text-slate-400 mr-3 shrink-0"></i>
        <input 
          x-ref="paletteInput"
          type="text" 
          x-model="paletteQuery"
          placeholder="Type a destination, school, or action... (Esc to close)" 
          class="w-full bg-transparent text-sm text-white placeholder-slate-500 focus:outline-none"
        >
        <span class="text-[10px] text-slate-400 font-mono bg-slate-800 px-1.5 py-0.5 rounded border border-slate-700">ESC</span>
      </div>

      <!-- Quick Results List -->
      <div class="max-h-80 overflow-y-auto p-2 divide-y divide-slate-800/40">
        <template x-for="item in filteredPaletteItems()" :key="item.url + item.title">
          <a 
            :href="item.url" 
            class="flex items-center justify-between p-2.5 rounded-xl hover:bg-slate-800 text-slate-200 hover:text-white transition group"
          >
            <div class="flex items-center space-x-3">
              <div class="w-7 h-7 rounded-lg bg-slate-800 group-hover:bg-indigo-600/20 text-slate-400 group-hover:text-indigo-400 flex items-center justify-center transition">
                <i :data-lucide="item.icon" class="w-4 h-4"></i>
              </div>
              <div>
                <p class="text-xs font-semibold text-white" x-text="item.title"></p>
                <p class="text-[11px] text-slate-400 font-mono" x-text="item.url"></p>
              </div>
            </div>
            <span class="text-[10px] text-slate-500 font-medium" x-text="item.category"></span>
          </a>
        </template>
        <div x-show="filteredPaletteItems().length === 0" class="py-8 text-center text-xs text-slate-400">
          No matching destinations or commands found.
        </div>
      </div>
      
      <!-- Footer Shortcut Hint -->
      <div class="px-4 py-2 bg-slate-950/60 border-t border-slate-800 flex items-center justify-between text-[11px] text-slate-500">
        <span>Prime School Master Command</span>
        <span>Navigation & Fleet Jump</span>
      </div>
    </div>
  </div>

  <!-- Mobile Slide-Over Backdrop -->
  <div 
    x-show="mobileNavOpen" 
    x-transition:enter="transition-opacity ease-linear duration-200"
    x-transition:enter-start="opacity-0"
    x-transition:enter-end="opacity-100"
    x-transition:leave="transition-opacity ease-linear duration-200"
    x-transition:leave-start="opacity-100"
    x-transition:leave-end="opacity-0"
    class="fixed inset-0 bg-slate-950/80 backdrop-blur-sm z-40 lg:hidden"
    @click="mobileNavOpen = false"
    x-cloak
  ></div>

  <!-- Mobile Slide-Over Drawer Navigation -->
  <aside 
    x-show="mobileNavOpen"
    x-transition:enter="transition ease-in-out duration-300 transform"
    x-transition:enter-start="-translate-x-full"
    x-transition:enter-end="translate-x-0"
    x-transition:leave="transition ease-in-out duration-300 transform"
    x-transition:leave-start="translate-x-0"
    x-transition:leave-end="-translate-x-full"
    class="fixed inset-y-0 left-0 w-72 bg-slate-900 border-r border-slate-800 z-50 flex flex-col justify-between lg:hidden shadow-2xl overflow-y-auto"
    x-cloak
  >
    <div>
      <!-- Drawer Header -->
      <div class="p-5 border-b border-slate-800 flex items-center justify-between">
        <div class="flex items-center space-x-3">
          <div class="w-9 h-9 rounded-xl bg-indigo-600 flex items-center justify-center font-bold text-white shadow-md shadow-indigo-600/30">
            <i data-lucide="shield" class="w-4 h-4 text-white"></i>
          </div>
          <div>
            <h1 class="text-sm font-bold text-white tracking-tight">Prime School</h1>
            <p class="text-[11px] text-slate-400">Master Control Plane</p>
          </div>
        </div>
        <button @click="mobileNavOpen = false" class="p-2 rounded-lg text-slate-400 hover:text-white hover:bg-slate-800 transition" aria-label="Close menu">
          <i data-lucide="x" class="w-5 h-5"></i>
        </button>
      </div>

      <!-- Navigation Items (Mobile) -->
      <nav class="p-4 space-y-1 text-xs font-medium">
        <a href="/" class="flex items-center space-x-3 px-3.5 py-2.5 rounded-xl transition <%= (typeof currentPath !== 'undefined' && currentPath === '/') ? 'bg-indigo-600 text-white font-semibold' : 'text-slate-400 hover:text-white hover:bg-slate-800/60' %>">
          <i data-lucide="layout-dashboard" class="w-4 h-4"></i>
          <span>Fleet Overview</span>
        </a>

        <a href="/schools" class="flex items-center space-x-3 px-3.5 py-2.5 rounded-xl transition <%= (typeof currentPath !== 'undefined' && currentPath.startsWith('/schools') && currentPath !== '/schools/new') ? 'bg-indigo-600 text-white font-semibold' : 'text-slate-400 hover:text-white hover:bg-slate-800/60' %>">
          <i data-lucide="school" class="w-4 h-4"></i>
          <span>School Instances</span>
        </a>

        <a href="/schools/new" class="flex items-center space-x-3 px-3.5 py-2.5 rounded-xl transition <%= (typeof currentPath !== 'undefined' && currentPath === '/schools/new') ? 'bg-emerald-600 text-white font-semibold' : 'text-emerald-400 hover:text-emerald-300 hover:bg-emerald-500/10' %>">
          <i data-lucide="plus-circle" class="w-4 h-4"></i>
          <span class="font-semibold">Onboard New School</span>
        </a>

        <a href="/master-data" class="flex items-center space-x-3 px-3.5 py-2.5 rounded-xl transition <%= (typeof currentPath !== 'undefined' && currentPath.startsWith('/master-data')) ? 'bg-indigo-600 text-white font-semibold' : 'text-slate-400 hover:text-white hover:bg-slate-800/60' %>">
          <i data-lucide="database" class="w-4 h-4"></i>
          <span>Master Data & Verify</span>
        </a>

        <a href="/networks" class="flex items-center space-x-3 px-3.5 py-2.5 rounded-xl transition <%= (typeof currentPath !== 'undefined' && currentPath.startsWith('/networks')) ? 'bg-indigo-600 text-white font-semibold' : 'text-slate-400 hover:text-white hover:bg-slate-800/60' %>">
          <i data-lucide="network" class="w-4 h-4"></i>
          <span>Networks & Domains</span>
        </a>

        <a href="/users" class="flex items-center space-x-3 px-3.5 py-2.5 rounded-xl transition <%= (typeof currentPath !== 'undefined' && currentPath.startsWith('/users')) ? 'bg-indigo-600 text-white font-semibold' : 'text-slate-400 hover:text-white hover:bg-slate-800/60' %>">
          <i data-lucide="shield-check" class="w-4 h-4"></i>
          <span>Users & Access</span>
        </a>
      </nav>
    </div>

    <!-- Mobile Drawer Footer Profile -->
    <div class="p-4 border-t border-slate-800">
      <div class="bg-slate-800/60 rounded-xl p-3 flex items-center justify-between">
        <div class="flex items-center space-x-2.5 truncate">
          <div class="w-7 h-7 rounded-full bg-indigo-500/20 text-indigo-400 flex items-center justify-center font-bold text-xs">
            <i data-lucide="user" class="w-3.5 h-3.5"></i>
          </div>
          <div class="truncate">
            <p class="text-xs font-semibold text-white truncate"><%= (typeof user !== 'undefined' && user) ? user.username : 'Super Admin' %></p>
            <p class="text-[10px] text-slate-400">Master Operator</p>
          </div>
        </div>
        <a href="/auth/logout" title="Sign Out" class="p-1.5 text-slate-400 hover:text-rose-400 transition">
          <i data-lucide="log-out" class="w-4 h-4"></i>
        </a>
      </div>
    </div>
  </aside>

  <!-- Desktop Sticky Sidebar Navigation -->
  <aside class="hidden lg:flex w-64 bg-slate-900 border-r border-slate-800 flex-col justify-between shrink-0 sticky top-0 h-screen z-30">
    <div>
      <!-- Brand & Header -->
      <div class="p-5 border-b border-slate-800 flex items-center justify-between">
        <div class="flex items-center space-x-3">
          <div class="w-8 h-8 rounded-lg bg-indigo-600 flex items-center justify-center font-bold text-white shadow-sm">
            <i data-lucide="shield" class="w-4 h-4 text-white"></i>
          </div>
          <div>
            <h1 class="text-sm font-bold text-white tracking-tight">Prime School</h1>
            <p class="text-[11px] text-slate-400">Master Control Plane</p>
          </div>
        </div>
      </div>

      <!-- Navigation Items -->
      <nav class="p-3 space-y-1 text-xs font-medium">
        <a href="/" class="flex items-center space-x-3 px-3 py-2.5 rounded-xl transition <%= (typeof currentPath !== 'undefined' && currentPath === '/') ? 'bg-indigo-600 text-white font-semibold' : 'text-slate-400 hover:text-white hover:bg-slate-800/60' %>">
          <i data-lucide="layout-dashboard" class="w-4 h-4"></i>
          <span>Fleet Overview</span>
        </a>

        <a href="/schools" class="flex items-center space-x-3 px-3 py-2.5 rounded-xl transition <%= (typeof currentPath !== 'undefined' && currentPath.startsWith('/schools') && currentPath !== '/schools/new') ? 'bg-indigo-600 text-white font-semibold' : 'text-slate-400 hover:text-white hover:bg-slate-800/60' %>">
          <i data-lucide="school" class="w-4 h-4"></i>
          <span>School Instances</span>
        </a>

        <a href="/schools/new" class="flex items-center space-x-3 px-3 py-2.5 rounded-xl transition <%= (typeof currentPath !== 'undefined' && currentPath === '/schools/new') ? 'bg-emerald-600 text-white font-semibold' : 'text-emerald-400 hover:text-emerald-300 hover:bg-emerald-500/10' %>">
          <i data-lucide="plus-circle" class="w-4 h-4"></i>
          <span class="font-semibold">Onboard New School</span>
        </a>

        <a href="/master-data" class="flex items-center space-x-3 px-3 py-2.5 rounded-xl transition <%= (typeof currentPath !== 'undefined' && currentPath.startsWith('/master-data')) ? 'bg-indigo-600 text-white font-semibold' : 'text-slate-400 hover:text-white hover:bg-slate-800/60' %>">
          <i data-lucide="database" class="w-4 h-4"></i>
          <span>Master Data & Verify</span>
        </a>

        <a href="/networks" class="flex items-center space-x-3 px-3 py-2.5 rounded-xl transition <%= (typeof currentPath !== 'undefined' && currentPath.startsWith('/networks')) ? 'bg-indigo-600 text-white font-semibold' : 'text-slate-400 hover:text-white hover:bg-slate-800/60' %>">
          <i data-lucide="network" class="w-4 h-4"></i>
          <span>Networks & Domains</span>
        </a>

        <a href="/users" class="flex items-center space-x-3 px-3 py-2.5 rounded-xl transition <%= (typeof currentPath !== 'undefined' && currentPath.startsWith('/users')) ? 'bg-indigo-600 text-white font-semibold' : 'text-slate-400 hover:text-white hover:bg-slate-800/60' %>">
          <i data-lucide="shield-check" class="w-4 h-4"></i>
          <span>Users & Access</span>
        </a>
      </nav>
    </div>

    <!-- Corporate Information & Sign Out -->
    <div class="p-3 border-t border-slate-800 space-y-2">
      <div class="bg-slate-800/40 rounded-xl p-2.5 flex items-center justify-between border border-slate-800/80">
        <div class="flex items-center space-x-2 truncate">
          <div class="w-7 h-7 rounded-full bg-indigo-500/20 text-indigo-400 flex items-center justify-center font-bold text-xs shrink-0">
            <i data-lucide="user" class="w-3.5 h-3.5"></i>
          </div>
          <div class="truncate">
            <p class="text-xs font-semibold text-white truncate"><%= (typeof user !== 'undefined' && user) ? user.username : 'Super Admin' %></p>
            <p class="text-[10px] text-slate-400">Master Operator</p>
          </div>
        </div>
        <a href="/auth/logout" title="Sign Out" class="p-1.5 text-slate-400 hover:text-rose-400 transition rounded-lg hover:bg-slate-800">
          <i data-lucide="log-out" class="w-3.5 h-3.5"></i>
        </a>
      </div>
      <div class="text-[10px] text-slate-500 text-center font-mono">
        Primeskill Solutions Pvt Ltd
      </div>
    </div>
  </aside>

  <!-- Main Content Wrapper -->
  <main class="flex-1 flex flex-col min-w-0 overflow-y-auto">
    <!-- Responsive Header Bar -->
    <header class="h-14 border-b border-slate-800 bg-slate-900/70 backdrop-blur-md px-4 sm:px-6 flex items-center justify-between shrink-0 sticky top-0 z-20">
      <!-- Left: Mobile Menu Trigger + Breadcrumb -->
      <div class="flex items-center space-x-3">
        <!-- Hamburger Button on Mobile -->
        <button 
          @click="mobileNavOpen = true" 
          class="lg:hidden p-1.5 rounded-lg text-slate-400 hover:text-white hover:bg-slate-800 focus:outline-none transition"
          aria-label="Open Navigation"
        >
          <i data-lucide="menu" class="w-5 h-5"></i>
        </button>

        <div class="flex items-center space-x-2">
          <h2 class="text-sm font-bold text-white tracking-tight"><%= typeof pageTitle !== 'undefined' ? pageTitle : 'Dashboard' %></h2>
        </div>
      </div>

      <!-- Center / Right: Quick Search Button & Status -->
      <div class="flex items-center space-x-3 text-xs">
        <!-- Command Palette Trigger Button -->
        <button 
          @click="commandPaletteOpen = true; $nextTick(() => $refs.paletteInput?.focus())"
          class="hidden sm:flex items-center space-x-2 px-3 py-1.5 rounded-lg bg-slate-800/80 hover:bg-slate-800 border border-slate-700/80 text-slate-400 hover:text-slate-200 transition"
        >
          <i data-lucide="search" class="w-3.5 h-3.5 text-slate-400"></i>
          <span class="text-xs">Quick search...</span>
          <span class="text-[10px] font-mono bg-slate-900 px-1.5 py-0.5 rounded border border-slate-700 text-slate-400">⌘K</span>
        </button>

        <div class="flex items-center space-x-2 px-2.5 py-1 rounded-full bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 font-medium text-[11px]">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
          <span>Fleet Mesh Online</span>
        </div>

        <a href="/schools/new" class="hidden md:flex items-center space-x-1.5 px-3 py-1.5 rounded-lg bg-indigo-600 hover:bg-indigo-500 text-white font-semibold transition text-xs shadow-sm">
          <i data-lucide="plus" class="w-3.5 h-3.5"></i>
          <span>New School</span>
        </a>
      </div>
    </header>

    <!-- Page Body Container -->
    <div class="p-4 sm:p-6 lg:p-8 flex-1">
