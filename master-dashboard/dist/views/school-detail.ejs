<%- include('partials/header') %>

<div class="mb-8 flex flex-col md:flex-row md:items-center md:justify-between gap-4">
  <div>
    <div class="flex items-center space-x-2 text-xs text-slate-400 mb-1">
      <a href="/schools" class="hover:text-indigo-400">Schools</a>
      <span>/</span>
      <span><%= school.slug %></span>
    </div>
    <div class="flex items-center space-x-3">
      <h1 class="text-2xl font-extrabold text-white tracking-tight"><%= school.name %></h1>
      <% if (school.status === 'active') { %>
        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
          ● Active
        </span>
      <% } else if (school.status === 'suspended') { %>
        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-amber-500/10 text-amber-400 border border-amber-500/20">
          ● Suspended
        </span>
      <% } else { %>
        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-slate-500/10 text-slate-400 border border-slate-500/20">
          ● Stopped
        </span>
      <% } %>
    </div>
  </div>

  <!-- Primary SSO Button -->
  <div class="flex items-center space-x-3">
    <a href="/schools/<%= school.id %>/sso-login" target="_blank" class="px-5 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-bold shadow-lg shadow-indigo-600/30 transition flex items-center space-x-2">
      <span>⚡</span>
      <span>Login as Super Admin (SSO)</span>
    </a>
  </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-8">
  <!-- Left Column: Specs & Endpoints -->
  <div class="glass-card rounded-2xl p-6 border border-slate-800 space-y-4">
    <h3 class="text-xs font-bold uppercase tracking-wider text-slate-400">Instance Specifications</h3>
    
    <div class="space-y-3 text-xs">
      <div class="flex justify-between py-2 border-b border-slate-800">
        <span class="text-slate-400">Subdomain:</span>
        <span class="font-mono text-white"><%= school.subdomain %></span>
      </div>
      <% if (school.customDomain) { %>
        <div class="flex justify-between py-2 border-b border-slate-800">
          <span class="text-slate-400">Custom Domain:</span>
          <span class="font-mono text-emerald-400"><%= school.customDomain %></span>
        </div>
      <% } %>
      <div class="flex justify-between py-2 border-b border-slate-800">
        <span class="text-slate-400">Tenant Database:</span>
        <span class="font-mono text-indigo-400"><%= school.dbName %></span>
      </div>
      <div class="flex justify-between py-2 border-b border-slate-800">
        <span class="text-slate-400">Docker Container:</span>
        <span class="font-mono text-white"><%= school.containerName %></span>
      </div>
      <div class="flex justify-between py-2 border-b border-slate-800">
        <span class="text-slate-400">Admin Email:</span>
        <span class="text-white"><%= school.adminEmail %></span>
      </div>
      <div class="flex justify-between py-2 border-b border-slate-800">
        <span class="text-slate-400">Storage Quota:</span>
        <span class="text-white"><%= school.storageQuotaGb %> GB</span>
      </div>
      <div class="flex justify-between py-2">
        <span class="text-slate-400">Max Students:</span>
        <span class="text-white"><%= school.maxStudents %></span>
      </div>
    </div>
  </div>

  <!-- Center & Right: Lifecycle Controls & Health -->
  <div class="lg:col-span-2 glass-card rounded-2xl p-6 border border-slate-800 flex flex-col justify-between">
    <div>
      <h3 class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-4">Container Controls</h3>
      <p class="text-xs text-slate-400 mb-6">Manage this school's runtime container, suspend non-paying clients, or restart Apache services.</p>

      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-6">
        <% if (school.status === 'active') { %>
          <form action="/schools/<%= school.id %>/restart" method="POST">
            <button type="submit" class="w-full py-2.5 px-3 bg-slate-800 hover:bg-slate-700 text-white rounded-xl text-xs font-semibold border border-slate-700 transition">
              🔄 Restart
            </button>
          </form>

          <form action="/schools/<%= school.id %>/stop" method="POST">
            <button type="submit" class="w-full py-2.5 px-3 bg-slate-800 hover:bg-slate-700 text-amber-400 rounded-xl text-xs font-semibold border border-slate-700 transition">
              ⏹️ Stop
            </button>
          </form>

          <form action="/schools/<%= school.id %>/suspend" method="POST">
            <button type="submit" class="w-full py-2.5 px-3 bg-amber-500/10 hover:bg-amber-500/20 text-amber-300 rounded-xl text-xs font-semibold border border-amber-500/30 transition">
              ⚠️ Suspend
            </button>
          </form>
        <% } else if (school.status === 'suspended') { %>
          <form action="/schools/<%= school.id %>/activate" method="POST">
            <button type="submit" class="w-full py-2.5 px-3 bg-emerald-600 hover:bg-emerald-500 text-white rounded-xl text-xs font-semibold transition">
              ✅ Unsuspend
            </button>
          </form>
        <% } else { %>
          <form action="/schools/<%= school.id %>/start" method="POST">
            <button type="submit" class="w-full py-2.5 px-3 bg-emerald-600 hover:bg-emerald-500 text-white rounded-xl text-xs font-semibold transition">
              ▶️ Start
            </button>
          </form>
        <% } %>

        <form action="/schools/<%= school.id %>/delete" method="POST" onsubmit="return confirm('Are you sure you want to permanently delete this school?');">
          <button type="submit" class="w-full py-2.5 px-3 bg-rose-500/10 hover:bg-rose-500/20 text-rose-400 rounded-xl text-xs font-semibold border border-rose-500/30 transition">
            🗑️ Delete
          </button>
        </form>
      </div>
    </div>

    <!-- Live Container Log Preview -->
    <div>
      <h4 class="text-xs font-semibold text-slate-400 mb-2 flex items-center justify-between">
        <span>Container Runtime Logs (Last 50 lines)</span>
        <span class="text-[10px] font-mono text-emerald-400">● Live Buffer</span>
      </h4>
      <pre class="bg-slate-950 p-4 rounded-xl text-[11px] font-mono text-slate-300 overflow-x-auto max-h-48 border border-slate-800/80"><%= logs %></pre>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
