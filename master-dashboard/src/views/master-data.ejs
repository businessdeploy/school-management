<%- include('partials/header') %>

<div class="mb-6">
  <h1 class="text-xl sm:text-2xl font-bold text-white tracking-tight">Master Data &amp; Cross-Verification</h1>
  <p class="text-slate-400 text-xs sm:text-sm mt-0.5">Cross-reference records, search students across campuses, and audit network-wide payment ledgers.</p>
</div>

<!-- Section 1: Global Cross-School Search Bar -->
<div class="control-surface p-5 mb-6">
  <div class="flex items-center space-x-2 mb-2">
    <i data-lucide="search" class="w-4 h-4 text-indigo-400"></i>
    <h2 class="text-sm font-semibold text-white">Cross-School Student &amp; Guardian Search</h2>
  </div>
  <p class="text-xs text-slate-400 mb-4">Query all school databases simultaneously to cross-verify admission numbers, find duplicate enrollments, or lookup student parent contact info.</p>

  <form action="/master-data" method="GET" class="flex flex-col sm:flex-row items-stretch sm:items-center gap-2">
    <div class="relative flex-1">
      <i data-lucide="search" class="w-3.5 h-3.5 absolute left-3 top-1/2 -translate-y-1/2 text-slate-400"></i>
      <input 
        type="text" 
        name="search" 
        value="<%= searchQuery %>" 
        placeholder="Enter student name, admission number, guardian phone, or email (e.g. Hayes or GW-2026)..." 
        class="w-full px-3 py-1.5 bg-slate-900 border border-slate-800 rounded-lg text-white text-xs placeholder-slate-500 focus:outline-none focus:border-indigo-500 transition pl-9"
      />
    </div>
    <div class="flex items-center space-x-2">
      <button type="submit" class="btn-control btn-control-primary">
        <i data-lucide="search" class="w-3.5 h-3.5"></i>
        <span>Search Fleet</span>
      </button>
      <% if (searchQuery) { %>
        <a href="/master-data" class="btn-control btn-control-secondary">
          Clear
        </a>
      <% } %>
    </div>
  </form>

  <!-- Search Results -->
  <% if (searchQuery) { %>
    <div class="mt-5 pt-4 border-t border-slate-800">
      <h3 class="text-xs font-semibold text-slate-300 mb-3 flex items-center space-x-2">
        <span>Search results for</span>
        <span class="text-indigo-400 font-mono bg-slate-900 px-2 py-0.5 rounded border border-slate-800">"<%= searchQuery %>"</span>
        <span class="text-slate-500">(<%= searchResults.length %> records found)</span>
      </h3>

      <% if (searchResults.length > 0) { %>
        <div class="overflow-x-auto">
          <table class="table-dense">
            <thead>
              <tr>
                <th>Admission No</th>
                <th>Student Name</th>
                <th>School / Campus</th>
                <th>Guardian / Contact</th>
                <th>Status</th>
                <th class="text-right">Action</th>
              </tr>
            </thead>
            <tbody>
              <% searchResults.forEach(function(r) { %>
                <tr class="control-row">
                  <td class="font-mono text-indigo-400 font-semibold"><%= r.admissionNo %></td>
                  <td class="text-white font-medium"><%= r.name %></td>
                  <td>
                    <span class="font-semibold text-slate-200"><%= r.schoolName %></span>
                    <span class="block text-[11px] text-slate-500 font-mono"><%= r.subdomain %></span>
                  </td>
                  <td class="text-slate-400">
                    <div><%= r.guardianName || 'N/A' %></div>
                    <div class="font-mono text-[11px] text-slate-500"><%= r.phone || r.email || '' %></div>
                  </td>
                  <td>
                    <span class="px-2 py-0.5 rounded text-[11px] font-medium <%= r.isActive === 'yes' ? 'bg-emerald-500/10 text-emerald-400 border border-emerald-500/20' : 'bg-rose-500/10 text-rose-400 border border-rose-500/20' %>">
                      <%= r.isActive === 'yes' ? 'Enrolled' : 'Inactive' %>
                    </span>
                  </td>
                  <td class="text-right">
                    <a href="/schools/<%= r.schoolId %>/sso-login" target="_blank" class="btn-control btn-control-secondary" style="height: 28px; padding: 0 8px; font-size: 11px;">
                      <i data-lucide="zap" class="w-3 h-3"></i>
                      <span>Verify in School</span>
                    </a>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } else { %>
        <div class="text-center py-6 text-slate-500 text-xs">
          No matching records found across your active school databases.
        </div>
      <% } %>
    </div>
  <% } %>
</div>

<!-- Section 2: Fleet Telemetry & Breakdown Table -->
<div class="control-surface p-5 mb-6">
  <div class="flex items-center space-x-2 mb-3 pb-2 border-b border-slate-800">
    <i data-lucide="bar-chart-2" class="w-4 h-4 text-indigo-400"></i>
    <h2 class="text-sm font-semibold text-white">Fleet-Wide Census &amp; Financial Overview</h2>
  </div>

  <div class="overflow-x-auto">
    <table class="table-dense">
      <thead>
        <tr>
          <th>School Name</th>
          <th class="text-right">Enrolled Students</th>
          <th class="text-right">Faculty &amp; Staff</th>
          <th class="text-right">Total Invoiced</th>
          <th class="text-right">Fees Collected</th>
          <th class="text-right">Outstanding Balance</th>
        </tr>
      </thead>
      <tbody>
        <% telemetry.schools.forEach(function(s) { %>
          <tr class="control-row">
            <td class="font-semibold text-white">
              <a href="/schools/<%= s.schoolId %>" class="hover:text-indigo-400 transition"><%= s.name %></a>
            </td>
            <td class="text-right font-medium text-slate-200 num-tabular"><%= s.studentsCount.toLocaleString() %></td>
            <td class="text-right font-medium text-slate-200 num-tabular"><%= s.staffCount.toLocaleString() %></td>
            <td class="text-right font-mono text-slate-300 num-tabular">₹<%= s.totalFeesInvoiced.toLocaleString('en-IN') %></td>
            <td class="text-right font-mono text-emerald-400 font-semibold num-tabular">₹<%= s.totalFeesCollected.toLocaleString('en-IN') %></td>
            <td class="text-right font-mono text-amber-400 num-tabular">₹<%= s.outstandingFees.toLocaleString('en-IN') %></td>
          </tr>
        <% }); %>
      </tbody>
      <tfoot class="bg-slate-900/80 font-bold text-white border-t border-slate-800">
        <tr>
          <td class="text-xs text-slate-400">Total Fleet Sum</td>
          <td class="text-right text-indigo-400 font-bold num-tabular"><%= telemetry.totalStudents.toLocaleString() %></td>
          <td class="text-right text-indigo-400 font-bold num-tabular"><%= telemetry.totalStaff.toLocaleString() %></td>
          <td class="text-right font-mono num-tabular">₹<%= (telemetry.totalCollected + telemetry.totalOutstanding).toLocaleString('en-IN') %></td>
          <td class="text-right font-mono text-emerald-400 font-bold num-tabular">₹<%= telemetry.totalCollected.toLocaleString('en-IN') %></td>
          <td class="text-right font-mono text-amber-400 font-bold num-tabular">₹<%= telemetry.totalOutstanding.toLocaleString('en-IN') %></td>
        </tr>
      </tfoot>
    </table>
  </div>
</div>

<!-- Section 3: Recent Cross-School Payment Ledger -->
<div class="control-surface p-5">
  <div class="flex items-center space-x-2 mb-2">
    <i data-lucide="circle-dollar-sign" class="w-4 h-4 text-emerald-400"></i>
    <h2 class="text-sm font-semibold text-white">Recent Cross-School Payment Transactions</h2>
  </div>
  <p class="text-xs text-slate-400 mb-4">Unified audit trail of student fee collections across all school instances.</p>

  <div class="overflow-x-auto">
    <table class="table-dense">
      <thead>
        <tr>
          <th>Invoice / Transaction ID</th>
          <th>School Campus</th>
          <th>Student &amp; Admission</th>
          <th>Payment Method</th>
          <th>Date</th>
          <th class="text-right">Amount</th>
        </tr>
      </thead>
      <tbody>
        <% recentPayments.forEach(function(p) { %>
          <tr class="control-row">
            <td class="font-mono text-indigo-400 font-semibold"><%= p.invoiceId %></td>
            <td class="text-white font-medium"><%= p.schoolName %></td>
            <td>
              <span class="text-slate-200"><%= p.studentName %></span>
              <span class="text-[11px] text-slate-500 font-mono block"><%= p.admissionNo %></span>
            </td>
            <td class="text-slate-400"><%= p.paymentMode %></td>
            <td class="text-slate-500 font-mono text-[11px]"><%= p.date %></td>
            <td class="text-right font-mono font-bold text-emerald-400 num-tabular">+₹<%= p.amount.toLocaleString('en-IN') %></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
</div>

<%- include('partials/footer') %>
