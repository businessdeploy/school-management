<%- include('partials/header') %>

<div class="mb-8">
  <h1 class="text-2xl font-extrabold text-white tracking-tight">Master Data & Cross-Verification Command</h1>
  <p class="text-slate-400 text-sm mt-1">Cross-reference records, search students across campuses, and audit network-wide payment ledgers.</p>
</div>

<!-- Section 1: Global Cross-School Search Bar -->
<div class="glass-card rounded-2xl p-6 border border-slate-800 mb-8 shadow-xl">
  <h3 class="text-xs font-bold uppercase tracking-wider text-indigo-400 mb-2 flex items-center space-x-2">
    <span>🔍</span>
    <span>Cross-School Student & Parent Search</span>
  </h3>
  <p class="text-xs text-slate-400 mb-4">Query all school databases simultaneously to cross-verify admission numbers, find duplicate enrollments, or lookup student parent contact info.</p>

  <form action="/master-data" method="GET" class="flex items-center gap-3">
    <div class="relative flex-1">
      <input 
        type="text" 
        name="search" 
        value="<%= searchQuery %>" 
        placeholder="Enter student name, admission number, guardian phone, or email (e.g. Hayes or GW-2026)..." 
        class="w-full px-4 py-3 bg-slate-900 border border-slate-700/80 rounded-xl text-white text-xs focus:outline-none focus:border-indigo-500 transition pl-10"
      />
      <span class="absolute left-3.5 top-3.5 text-slate-500 text-xs">🔎</span>
    </div>
    <button type="submit" class="px-6 py-3 bg-indigo-600 hover:bg-indigo-500 text-white rounded-xl text-xs font-bold transition shadow-md shadow-indigo-600/20">
      Search Fleet
    </button>
    <% if (searchQuery) { %>
      <a href="/master-data" class="px-4 py-3 bg-slate-800 hover:bg-slate-700 text-slate-300 rounded-xl text-xs font-medium transition">
        Clear
      </a>
    <% } %>
  </form>

  <!-- Search Results -->
  <% if (searchQuery) { %>
    <div class="mt-6 pt-6 border-t border-slate-800">
      <h4 class="text-xs font-semibold text-slate-300 mb-3">
        Search Results for "<span class="text-indigo-400 font-mono"><%= searchQuery %></span>" (<%= searchResults.length %> records found)
      </h4>

      <% if (searchResults.length > 0) { %>
        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs">
            <thead class="bg-slate-900 text-slate-400 font-semibold border-b border-slate-800 uppercase text-[10px]">
              <tr>
                <th class="px-4 py-3">Admission No</th>
                <th class="px-4 py-3">Student Name</th>
                <th class="px-4 py-3">School / Campus</th>
                <th class="px-4 py-3">Guardian / Phone</th>
                <th class="px-4 py-3">Status</th>
                <th class="px-4 py-3 text-right">Action</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-800/60">
              <% searchResults.forEach(function(r) { %>
                <tr class="hover:bg-slate-800/40 transition">
                  <td class="px-4 py-3 font-mono text-indigo-400 font-semibold"><%= r.admissionNo %></td>
                  <td class="px-4 py-3 text-white font-medium"><%= r.name %></td>
                  <td class="px-4 py-3">
                    <span class="font-bold text-slate-200"><%= r.schoolName %></span>
                    <span class="block text-[10px] text-slate-500 font-mono"><%= r.subdomain %></span>
                  </td>
                  <td class="px-4 py-3 text-slate-400">
                    <div><%= r.guardianName || 'N/A' %></div>
                    <div class="font-mono text-[11px] text-slate-500"><%= r.phone || r.email || '' %></div>
                  </td>
                  <td class="px-4 py-3">
                    <span class="px-2 py-0.5 rounded-full text-[10px] font-semibold <%= r.isActive === 'yes' ? 'bg-emerald-500/10 text-emerald-400' : 'bg-rose-500/10 text-rose-400' %>">
                      <%= r.isActive === 'yes' ? 'Enrolled' : 'Inactive' %>
                    </span>
                  </td>
                  <td class="px-4 py-3 text-right">
                    <a href="/schools/<%= r.schoolId %>/sso-login" target="_blank" class="px-2.5 py-1 rounded-lg bg-slate-800 hover:bg-slate-700 text-indigo-400 text-xs font-medium border border-slate-700 transition inline-flex items-center space-x-1">
                      <span>⚡</span>
                      <span>Verify in School</span>
                    </a>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } else { %>
        <div class="text-center py-6 text-slate-500 text-xs">
          No matching records found across your active school databases.
        </div>
      <% } %>
    </div>
  <% } %>
</div>

<!-- Section 2: Fleet Telemetry & Breakdown Table -->
<div class="glass-card rounded-2xl p-6 border border-slate-800 mb-8 shadow-xl">
  <h3 class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-4 flex items-center space-x-2">
    <span>📊</span>
    <span>Fleet-Wide Census & Financial Overview</span>
  </h3>

  <div class="overflow-x-auto">
    <table class="w-full text-left text-xs">
      <thead class="bg-slate-900 text-slate-400 font-semibold border-b border-slate-800 uppercase text-[10px]">
        <tr>
          <th class="px-4 py-3">School Name</th>
          <th class="px-4 py-3 text-center">Enrolled Students</th>
          <th class="px-4 py-3 text-center">Teachers / Staff</th>
          <th class="px-4 py-3 text-right">Total Invoiced</th>
          <th class="px-4 py-3 text-right">Fees Collected</th>
          <th class="px-4 py-3 text-right">Outstanding Balance</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-800/60">
        <% telemetry.schools.forEach(function(s) { %>
          <tr class="hover:bg-slate-800/40 transition">
            <td class="px-4 py-3 font-semibold text-white">
              <a href="/schools/<%= s.schoolId %>" class="hover:text-indigo-400 transition"><%= s.name %></a>
            </td>
            <td class="px-4 py-3 text-center font-bold text-slate-200"><%= s.studentsCount %></td>
            <td class="px-4 py-3 text-center font-bold text-slate-200"><%= s.staffCount %></td>
            <td class="px-4 py-3 text-right font-mono text-slate-300">$<%= s.totalFeesInvoiced.toLocaleString() %></td>
            <td class="px-4 py-3 text-right font-mono text-emerald-400 font-bold">$<%= s.totalFeesCollected.toLocaleString() %></td>
            <td class="px-4 py-3 text-right font-mono text-amber-400">$<%= s.outstandingFees.toLocaleString() %></td>
          </tr>
        <% }); %>
      </tbody>
      <tfoot class="bg-slate-900/80 font-bold text-white border-t border-slate-800">
        <tr>
          <td class="px-4 py-3 uppercase text-[11px] text-slate-400">Total Fleet Sum</td>
          <td class="px-4 py-3 text-center text-indigo-400 font-extrabold"><%= telemetry.totalStudents.toLocaleString() %></td>
          <td class="px-4 py-3 text-center text-indigo-400 font-extrabold"><%= telemetry.totalStaff.toLocaleString() %></td>
          <td class="px-4 py-3 text-right font-mono">$<%= (telemetry.totalCollected + telemetry.totalOutstanding).toLocaleString() %></td>
          <td class="px-4 py-3 text-right font-mono text-emerald-400 font-extrabold">$<%= telemetry.totalCollected.toLocaleString() %></td>
          <td class="px-4 py-3 text-right font-mono text-amber-400 font-extrabold">$<%= telemetry.totalOutstanding.toLocaleString() %></td>
        </tr>
      </tfoot>
    </table>
  </div>
</div>

<!-- Section 3: Recent Cross-School Payment Ledger -->
<div class="glass-card rounded-2xl p-6 border border-slate-800 shadow-xl">
  <h3 class="text-xs font-bold uppercase tracking-wider text-purple-400 mb-2 flex items-center space-x-2">
    <span>💰</span>
    <span>Recent Cross-School Payment Transactions</span>
  </h3>
  <p class="text-xs text-slate-400 mb-4">Unified audit trail of student fee collections across all school instances.</p>

  <div class="overflow-x-auto">
    <table class="w-full text-left text-xs">
      <thead class="bg-slate-900 text-slate-400 font-semibold border-b border-slate-800 uppercase text-[10px]">
        <tr>
          <th class="px-4 py-3">Invoice / Trans ID</th>
          <th class="px-4 py-3">School Campus</th>
          <th class="px-4 py-3">Student & Admission No</th>
          <th class="px-4 py-3">Method</th>
          <th class="px-4 py-3">Date</th>
          <th class="px-4 py-3 text-right">Amount</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-800/60">
        <% recentPayments.forEach(function(p) { %>
          <tr class="hover:bg-slate-800/40 transition">
            <td class="px-4 py-3 font-mono text-indigo-400 font-semibold"><%= p.invoiceId %></td>
            <td class="px-4 py-3 text-white font-medium"><%= p.schoolName %></td>
            <td class="px-4 py-3">
              <span class="text-slate-200"><%= p.studentName %></span>
              <span class="text-[10px] text-slate-500 font-mono block"><%= p.admissionNo %></span>
            </td>
            <td class="px-4 py-3 text-slate-400"><%= p.paymentMode %></td>
            <td class="px-4 py-3 text-slate-500 font-mono text-[11px]"><%= p.date %></td>
            <td class="px-4 py-3 text-right font-mono font-bold text-emerald-400">+$<%= p.amount.toLocaleString() %></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
</div>

<%- include('partials/footer') %>
