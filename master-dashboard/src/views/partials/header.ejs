<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof pageTitle !== 'undefined' ? pageTitle : 'Control Plane' %> | Prime School Fleet Master</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
  <script src="https://unpkg.com/lucide@latest"></script>
  <script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>
  <style>
    body { font-family: 'Plus Jakarta Sans', sans-serif; }
    .glass-card {
      background: rgba(15, 23, 42, 0.75);
      backdrop-filter: blur(12px);
      border: 1px solid rgba(255, 255, 255, 0.08);
    }
    .glass-card:hover {
      border-color: rgba(99, 102, 241, 0.25);
    }
    [x-cloak] { display: none !important; }
  </style>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            brand: {
              50: '#eef2ff',
              100: '#e0e7ff',
              500: '#6366f1',
              600: '#4f46e5',
              700: '#4338ca',
            }
          }
        }
      }
    }
  </script>
</head>
<body x-data="{ mobileNavOpen: false }" class="bg-slate-950 text-slate-100 flex min-h-screen antialiased selection:bg-indigo-500 selection:text-white">

  <!-- Mobile Slide-Over Backdrop -->
  <div 
    x-show="mobileNavOpen" 
    x-transition:enter="transition-opacity ease-linear duration-200"
    x-transition:enter-start="opacity-0"
    x-transition:enter-end="opacity-100"
    x-transition:leave="transition-opacity ease-linear duration-200"
    x-transition:leave-start="opacity-100"
    x-transition:leave-end="opacity-0"
    class="fixed inset-0 bg-slate-950/80 backdrop-blur-sm z-40 lg:hidden"
    @click="mobileNavOpen = false"
    x-cloak
  ></div>

  <!-- Mobile Slide-Over Drawer Navigation -->
  <aside 
    x-show="mobileNavOpen"
    x-transition:enter="transition ease-in-out duration-300 transform"
    x-transition:enter-start="-translate-x-full"
    x-transition:enter-end="translate-x-0"
    x-transition:leave="transition ease-in-out duration-300 transform"
    x-transition:leave-start="translate-x-0"
    x-transition:leave-end="-translate-x-full"
    class="fixed inset-y-0 left-0 w-72 bg-slate-900 border-r border-slate-800 z-50 flex flex-col justify-between lg:hidden shadow-2xl overflow-y-auto"
    x-cloak
  >
    <div>
      <!-- Drawer Header -->
      <div class="p-5 border-b border-slate-800 flex items-center justify-between">
        <div class="flex items-center space-x-3">
          <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-indigo-600 to-indigo-400 flex items-center justify-center font-bold text-white shadow-lg shadow-indigo-500/20">
            <i data-lucide="shield" class="w-5 h-5 text-white"></i>
          </div>
          <div>
            <h1 class="text-sm font-bold text-white tracking-tight">Prime School</h1>
            <p class="text-[10px] text-indigo-400 font-semibold tracking-wide uppercase">Fleet Master Control</p>
          </div>
        </div>
        <button @click="mobileNavOpen = false" class="p-2 rounded-lg text-slate-400 hover:text-white hover:bg-slate-800 transition">
          <i data-lucide="x" class="w-5 h-5"></i>
        </button>
      </div>

      <!-- Navigation Items (Mobile) -->
      <nav class="p-4 space-y-1 text-sm font-medium">
        <a href="/" class="flex items-center space-x-3 px-4 py-2.5 rounded-xl transition <%= (typeof currentPath !== 'undefined' && currentPath === '/') ? 'bg-indigo-600 text-white shadow-md shadow-indigo-600/30 font-semibold' : 'text-slate-400 hover:text-white hover:bg-slate-800/60' %>">
          <i data-lucide="layout-dashboard" class="w-4 h-4"></i>
          <span>Fleet Overview</span>
        </a>

        <a href="/schools" class="flex items-center space-x-3 px-4 py-2.5 rounded-xl transition <%= (typeof currentPath !== 'undefined' && currentPath.startsWith('/schools') && currentPath !== '/schools/new') ? 'bg-indigo-600 text-white shadow-md shadow-indigo-600/30 font-semibold' : 'text-slate-400 hover:text-white hover:bg-slate-800/60' %>">
          <i data-lucide="school" class="w-4 h-4"></i>
          <span>School Instances</span>
        </a>

        <a href="/schools/new" class="flex items-center space-x-3 px-4 py-2.5 rounded-xl transition <%= (typeof currentPath !== 'undefined' && currentPath === '/schools/new') ? 'bg-emerald-600 text-white shadow-md shadow-emerald-600/30 font-semibold' : 'text-emerald-400 hover:text-emerald-300 hover:bg-emerald-500/10' %>">
          <i data-lucide="plus-circle" class="w-4 h-4"></i>
          <span class="font-semibold">Onboard New School</span>
        </a>

        <a href="/master-data" class="flex items-center space-x-3 px-4 py-2.5 rounded-xl transition <%= (typeof currentPath !== 'undefined' && currentPath.startsWith('/master-data')) ? 'bg-indigo-600 text-white shadow-md shadow-indigo-600/30 font-semibold' : 'text-slate-400 hover:text-white hover:bg-slate-800/60' %>">
          <i data-lucide="database" class="w-4 h-4"></i>
          <span>Master Data & Verify</span>
        </a>

        <a href="/networks" class="flex items-center space-x-3 px-4 py-2.5 rounded-xl transition <%= (typeof currentPath !== 'undefined' && currentPath.startsWith('/networks')) ? 'bg-indigo-600 text-white shadow-md shadow-indigo-600/30 font-semibold' : 'text-slate-400 hover:text-white hover:bg-slate-800/60' %>">
          <i data-lucide="network" class="w-4 h-4"></i>
          <span>Networks & Domains</span>
        </a>

        <a href="/users" class="flex items-center space-x-3 px-4 py-2.5 rounded-xl transition <%= (typeof currentPath !== 'undefined' && currentPath.startsWith('/users')) ? 'bg-indigo-600 text-white shadow-md shadow-indigo-600/30 font-semibold' : 'text-slate-400 hover:text-white hover:bg-slate-800/60' %>">
          <i data-lucide="shield-check" class="w-4 h-4"></i>
          <span>Users & Access</span>
        </a>
      </nav>
    </div>

    <!-- Mobile Drawer Footer Profile -->
    <div class="p-4 border-t border-slate-800">
      <div class="bg-slate-800/60 rounded-xl p-3 flex items-center justify-between">
        <div class="flex items-center space-x-3 truncate">
          <div class="w-8 h-8 rounded-full bg-indigo-500/20 text-indigo-400 flex items-center justify-center font-bold text-xs">
            <i data-lucide="user" class="w-4 h-4"></i>
          </div>
          <div class="truncate">
            <p class="text-xs font-semibold text-white truncate"><%= (typeof user !== 'undefined' && user) ? user.username : 'Super Admin' %></p>
            <p class="text-[10px] text-slate-400">Master Operator</p>
          </div>
        </div>
        <a href="/auth/logout" title="Sign Out" class="p-1.5 text-slate-400 hover:text-rose-400 transition">
          <i data-lucide="log-out" class="w-4 h-4"></i>
        </a>
      </div>
    </div>
  </aside>

  <!-- Desktop Sticky Sidebar Navigation -->
  <aside class="hidden lg:flex w-72 bg-slate-900 border-r border-slate-800 flex-col justify-between shrink-0 sticky top-0 h-screen z-30">
    <div>
      <!-- Brand & Header -->
      <div class="p-6 border-b border-slate-800 flex items-center justify-between">
        <div class="flex items-center space-x-3">
          <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-indigo-600 to-indigo-400 flex items-center justify-center font-bold text-white shadow-lg shadow-indigo-500/20">
            <i data-lucide="shield" class="w-5 h-5 text-white"></i>
          </div>
          <div>
            <h1 class="text-base font-bold text-white tracking-tight">Prime School</h1>
            <p class="text-[10px] text-indigo-400 font-semibold tracking-wide uppercase">Fleet Master Control</p>
          </div>
        </div>
      </div>

      <!-- Navigation Items -->
      <nav class="p-4 space-y-1.5 text-sm font-medium">
        <a href="/" class="flex items-center space-x-3 px-4 py-2.5 rounded-xl transition <%= (typeof currentPath !== 'undefined' && currentPath === '/') ? 'bg-indigo-600 text-white shadow-md shadow-indigo-600/30 font-semibold' : 'text-slate-400 hover:text-white hover:bg-slate-800/60' %>">
          <i data-lucide="layout-dashboard" class="w-4 h-4"></i>
          <span>Fleet Overview</span>
        </a>

        <a href="/schools" class="flex items-center space-x-3 px-4 py-2.5 rounded-xl transition <%= (typeof currentPath !== 'undefined' && currentPath.startsWith('/schools') && currentPath !== '/schools/new') ? 'bg-indigo-600 text-white shadow-md shadow-indigo-600/30 font-semibold' : 'text-slate-400 hover:text-white hover:bg-slate-800/60' %>">
          <i data-lucide="school" class="w-4 h-4"></i>
          <span>School Instances</span>
        </a>

        <a href="/schools/new" class="flex items-center space-x-3 px-4 py-2.5 rounded-xl transition <%= (typeof currentPath !== 'undefined' && currentPath === '/schools/new') ? 'bg-emerald-600 text-white shadow-md shadow-emerald-600/30 font-semibold' : 'text-emerald-400 hover:text-emerald-300 hover:bg-emerald-500/10' %>">
          <i data-lucide="plus-circle" class="w-4 h-4"></i>
          <span class="font-semibold">Onboard New School</span>
        </a>

        <a href="/master-data" class="flex items-center space-x-3 px-4 py-2.5 rounded-xl transition <%= (typeof currentPath !== 'undefined' && currentPath.startsWith('/master-data')) ? 'bg-indigo-600 text-white shadow-md shadow-indigo-600/30 font-semibold' : 'text-slate-400 hover:text-white hover:bg-slate-800/60' %>">
          <i data-lucide="database" class="w-4 h-4"></i>
          <span>Master Data & Verify</span>
        </a>

        <a href="/networks" class="flex items-center space-x-3 px-4 py-2.5 rounded-xl transition <%= (typeof currentPath !== 'undefined' && currentPath.startsWith('/networks')) ? 'bg-indigo-600 text-white shadow-md shadow-indigo-600/30 font-semibold' : 'text-slate-400 hover:text-white hover:bg-slate-800/60' %>">
          <i data-lucide="network" class="w-4 h-4"></i>
          <span>Networks & Domains</span>
        </a>

        <a href="/users" class="flex items-center space-x-3 px-4 py-2.5 rounded-xl transition <%= (typeof currentPath !== 'undefined' && currentPath.startsWith('/users')) ? 'bg-indigo-600 text-white shadow-md shadow-indigo-600/30 font-semibold' : 'text-slate-400 hover:text-white hover:bg-slate-800/60' %>">
          <i data-lucide="shield-check" class="w-4 h-4"></i>
          <span>Users & Access</span>
        </a>
      </nav>
    </div>

    <!-- Corporate Information & Sign Out -->
    <div class="p-4 border-t border-slate-800 space-y-3">
      <div class="bg-slate-800/40 rounded-xl p-3 flex items-center justify-between border border-slate-800/80">
        <div class="flex items-center space-x-2.5 truncate">
          <div class="w-8 h-8 rounded-full bg-indigo-500/20 text-indigo-400 flex items-center justify-center font-bold text-xs shrink-0">
            <i data-lucide="user" class="w-4 h-4"></i>
          </div>
          <div class="truncate">
            <p class="text-xs font-semibold text-white truncate"><%= (typeof user !== 'undefined' && user) ? user.username : 'Super Admin' %></p>
            <p class="text-[10px] text-slate-400">Master Operator</p>
          </div>
        </div>
        <a href="/auth/logout" title="Sign Out" class="p-1.5 text-slate-400 hover:text-rose-400 transition rounded-lg hover:bg-slate-800">
          <i data-lucide="log-out" class="w-4 h-4"></i>
        </a>
      </div>
      <div class="text-[10px] text-slate-500 text-center">
        Primeskill Solutions Pvt Ltd
      </div>
    </div>
  </aside>

  <!-- Main Content Wrapper -->
  <main class="flex-1 flex flex-col min-w-0 overflow-y-auto">
    <!-- Responsive Header Bar -->
    <header class="h-16 border-b border-slate-800 bg-slate-900/70 backdrop-blur-md px-4 sm:px-8 flex items-center justify-between shrink-0 sticky top-0 z-20">
      <!-- Left: Mobile Menu Trigger + Breadcrumb -->
      <div class="flex items-center space-x-3 sm:space-x-4">
        <!-- Hamburger Button on Mobile -->
        <button 
          @click="mobileNavOpen = true" 
          class="lg:hidden p-2 rounded-xl text-slate-400 hover:text-white hover:bg-slate-800 focus:outline-none transition"
          aria-label="Open Navigation"
        >
          <i data-lucide="menu" class="w-5 h-5"></i>
        </button>

        <div>
          <h2 class="text-sm sm:text-base font-bold text-white tracking-tight"><%= typeof pageTitle !== 'undefined' ? pageTitle : 'Dashboard' %></h2>
          <p class="text-[11px] text-slate-400 hidden sm:block">Prime School Multi-Tenant Operating System</p>
        </div>
      </div>

      <!-- Right: Mesh Status & Fast Switcher -->
      <div class="flex items-center space-x-3 text-xs">
        <div class="flex items-center space-x-2 px-3 py-1.5 rounded-full bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 font-medium">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          <span class="hidden md:inline">Fleet Mesh: 100% Operational</span>
          <span class="md:hidden">Mesh OK</span>
        </div>
        <a href="/schools/new" class="hidden sm:flex items-center space-x-1.5 px-3 py-1.5 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white font-semibold transition shadow-sm">
          <i data-lucide="plus" class="w-3.5 h-3.5"></i>
          <span>New School</span>
        </a>
      </div>
    </header>

    <!-- Page Body Container -->
    <div class="p-4 sm:p-6 lg:p-8 flex-1">
