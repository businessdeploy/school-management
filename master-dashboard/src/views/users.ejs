<%- include('partials/header') %>

<div class="mb-6">
  <h1 class="text-xl sm:text-2xl font-bold text-white tracking-tight">Operators &amp; Access Control</h1>
  <p class="text-slate-400 text-xs sm:text-sm mt-0.5">Manage named operators, roles, and account security for the master control plane.</p>
</div>

<% if (error) { %>
  <div class="p-3.5 mb-5 rounded-lg bg-rose-500/10 border border-rose-500/20 text-rose-400 text-xs font-medium flex items-center space-x-2">
    <i data-lucide="alert-triangle" class="w-4 h-4 text-rose-400"></i>
    <span><%= error %></span>
  </div>
<% } %>

<% if (success) { %>
  <div class="p-3.5 mb-5 rounded-lg bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-xs font-medium flex items-center space-x-2">
    <i data-lucide="check-circle" class="w-4 h-4 text-emerald-400"></i>
    <span><%= success %></span>
  </div>
<% } %>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
  <!-- Existing users -->
  <div class="lg:col-span-2 control-surface p-5">
    <div class="flex items-center justify-between mb-3 pb-2 border-b border-slate-800">
      <h2 class="text-xs font-semibold text-white flex items-center space-x-2">
        <i data-lucide="users" class="w-4 h-4 text-indigo-400"></i>
        <span>Master Operators</span>
      </h2>
      <span class="text-xs text-indigo-400 font-medium"><%= users.length %> Total</span>
    </div>

    <div class="overflow-x-auto">
      <table class="table-dense">
        <thead>
          <tr>
            <th>Username</th>
            <th>Display Name</th>
            <th>Role</th>
            <th>MFA</th>
            <th>Status</th>
            <th class="text-right">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% users.forEach(function(u) { %>
            <tr class="control-row">
              <td class="font-mono text-white font-medium">
                <span class="inline-flex items-center space-x-1.5">
                  <i data-lucide="user" class="w-3.5 h-3.5 text-slate-500"></i>
                  <span><%= u.username %></span>
                </span>
              </td>
              <td class="text-slate-300"><%= u.displayName || '—' %></td>
              <td>
                <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-indigo-500/10 text-indigo-400 border border-indigo-500/20"><%= u.role %></span>
              </td>
              <td>
                <% if (u.mfaSecret) { %>
                  <span class="text-emerald-400 font-medium flex items-center space-x-1">
                    <i data-lucide="shield-check" class="w-3.5 h-3.5"></i>
                    <span>Enabled</span>
                  </span>
                <% } else { %>
                  <span class="text-slate-500">—</span>
                <% } %>
              </td>
              <td>
                <% if (u.isActive) { %>
                  <span class="inline-flex items-center space-x-1 text-emerald-400">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                    <span>Active</span>
                  </span>
                <% } else { %>
                  <span class="inline-flex items-center space-x-1 text-slate-500">
                    <span class="w-1.5 h-1.5 rounded-full bg-slate-500"></span>
                    <span>Inactive</span>
                  </span>
                <% } %>
              </td>
              <td class="text-right whitespace-nowrap">
                <form action="/users/<%= u.id %>/toggle-active" method="POST" class="inline">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button type="submit" class="btn-control btn-control-secondary" style="height: 26px; padding: 0 8px; font-size: 10px;">
                    <%= u.isActive ? 'Deactivate' : 'Activate' %>
                  </button>
                </form>
                <% if (u.mfaSecret) { %>
                  <form action="/users/<%= u.id %>/mfa-disable" method="POST" class="inline ml-1">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button type="submit" class="btn-control btn-control-secondary text-amber-400" style="height: 26px; padding: 0 8px; font-size: 10px;">
                      Disable MFA
                    </button>
                  </form>
                <% } else { %>
                  <a href="/users/<%= u.id %>/mfa-setup" class="inline-block ml-1 btn-control btn-control-secondary text-indigo-400" style="height: 26px; padding: 0 8px; font-size: 10px;">
                    Setup MFA
                  </a>
                <% } %>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Create user -->
  <div class="control-surface p-5 self-start">
    <div class="border-b border-slate-800 pb-2 mb-3">
      <h2 class="text-xs font-semibold text-white flex items-center space-x-2">
        <i data-lucide="user-plus" class="w-4 h-4 text-indigo-400"></i>
        <span>Invite Operator</span>
      </h2>
    </div>
    <form action="/users/create" method="POST" class="space-y-3">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div>
        <label class="block text-[11px] font-medium text-slate-300 mb-1">Username</label>
        <input type="text" name="username" required class="w-full px-3 py-1.5 bg-slate-900 border border-slate-800 rounded-lg text-white text-xs focus:outline-none focus:border-indigo-500 transition" />
      </div>

      <div>
        <label class="block text-[11px] font-medium text-slate-300 mb-1">Display Name</label>
        <input type="text" name="displayName" class="w-full px-3 py-1.5 bg-slate-900 border border-slate-800 rounded-lg text-white text-xs focus:outline-none focus:border-indigo-500 transition" />
      </div>

      <div>
        <label class="block text-[11px] font-medium text-slate-300 mb-1">Password</label>
        <input type="password" name="password" required minlength="6" autocomplete="new-password" class="w-full px-3 py-1.5 bg-slate-900 border border-slate-800 rounded-lg text-white text-xs focus:outline-none focus:border-indigo-500 transition" />
      </div>

      <div>
        <label class="block text-[11px] font-medium text-slate-300 mb-1">Role</label>
        <select name="role" class="w-full px-3 py-1.5 bg-slate-900 border border-slate-800 rounded-lg text-white text-xs focus:outline-none focus:border-indigo-500 transition">
          <% roles.forEach(function(r) { %>
            <option value="<%= r %>"><%= r %></option>
          <% }); %>
        </select>
      </div>

      <button type="submit" class="w-full btn-control btn-control-primary justify-center">
        <i data-lucide="plus" class="w-3.5 h-3.5"></i>
        <span>Create Operator</span>
      </button>
    </form>
  </div>
</div>

<%- include('partials/footer') %>
