<%- include('partials/header') %>

<div class="mb-8">
  <h1 class="text-2xl font-extrabold text-white tracking-tight">Multi-Network & Custom Domain Routing</h1>
  <p class="text-slate-400 text-sm mt-1">Configure root networks for reseller white-labeling, bind custom domains to schools, and verify live DNS propagation.</p>
</div>

<!-- Section 1: Live DNS Verification Tool -->
<div class="glass-card rounded-2xl p-6 border border-slate-800 mb-8 shadow-xl">
  <h3 class="text-xs font-bold uppercase tracking-wider text-indigo-400 mb-2 flex items-center space-x-2">
    <span>🌐</span>
    <span>Live Custom Domain DNS Checker</span>
  </h3>
  <p class="text-xs text-slate-400 mb-4">Before enabling a custom domain for a school, verify that their CNAME or A-record resolves to your server ingress.</p>

  <form action="/networks/verify-domain" method="POST" class="grid grid-cols-1 md:grid-cols-3 gap-3">
    <div>
      <label class="block text-[11px] font-medium text-slate-400 mb-1">School Custom Domain</label>
      <input type="text" name="domain" placeholder="e.g. portal.greenwoodhigh.edu" required class="w-full px-4 py-2.5 bg-slate-900 border border-slate-700/80 rounded-xl text-white text-xs font-mono focus:outline-none focus:border-indigo-500 transition" />
    </div>

    <div>
      <label class="block text-[11px] font-medium text-slate-400 mb-1">Expected Ingress Host / IP</label>
      <input type="text" name="expectedTarget" value="ingress.yournetwork.com" class="w-full px-4 py-2.5 bg-slate-900 border border-slate-700/80 rounded-xl text-white text-xs font-mono focus:outline-none focus:border-indigo-500 transition" />
    </div>

    <div class="flex items-end">
      <button type="submit" class="w-full py-2.5 px-4 bg-indigo-600 hover:bg-indigo-500 text-white rounded-xl text-xs font-bold transition shadow-md shadow-indigo-600/20">
        Run Live DNS Check
      </button>
    </div>
  </form>

  <% if (dnsResult) { %>
    <div class="mt-5 p-4 rounded-xl border text-xs <%= dnsResult.isConfigured ? 'bg-emerald-500/10 border-emerald-500/20 text-emerald-400' : 'bg-rose-500/10 border-rose-500/20 text-rose-400' %>">
      <div class="font-bold mb-1">
        <%= dnsResult.isConfigured ? '✅ DNS Verified & Ready for On-Demand TLS!' : '❌ DNS Records Not Yet Pointing to Ingress' %>
      </div>
      <div>Domain: <span class="font-mono"><%= dnsResult.domain %></span></div>
      <div>Records Found: <span class="font-mono"><%= dnsResult.recordsFound.length > 0 ? dnsResult.recordsFound.join(', ') : 'None' %></span></div>
      <% if (dnsResult.error) { %>
        <div class="text-[11px] text-slate-400 mt-1">Details: <%= dnsResult.error %></div>
      <% } %>
    </div>
  <% } %>
</div>

<div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-8">
  <!-- Section 2: Active Networks (Reseller / Group Chains) -->
  <div class="glass-card rounded-2xl p-6 border border-slate-800 shadow-xl">
    <div class="flex items-center justify-between mb-4">
      <h3 class="text-xs font-bold uppercase tracking-wider text-white">Active Root Networks</h3>
      <span class="text-xs text-indigo-400 font-semibold"><%= networks.length %> Networks</span>
    </div>

    <div class="space-y-3 mb-6">
      <% networks.forEach(function(n) { %>
        <div class="p-4 bg-slate-900/80 rounded-xl border border-slate-800 flex items-center justify-between">
          <div>
            <div class="flex items-center space-x-2">
              <span class="font-bold text-white text-xs"><%= n.name %></span>
              <% if (n.isDefault) { %>
                <span class="px-2 py-0.5 rounded-full text-[9px] font-bold bg-brand-500/10 text-brand-400 border border-brand-500/20">DEFAULT</span>
              <% } %>
            </div>
            <p class="text-xs font-mono text-indigo-400 mt-0.5">*. <%= n.rootDomain %></p>
            <% if (n.description) { %>
              <p class="text-[11px] text-slate-400 mt-1"><%= n.description %></p>
            <% } %>
          </div>
          <span class="text-xs text-slate-500">Auto-SSL</span>
        </div>
      <% }); %>
    </div>

    <!-- Add Network Form -->
    <div class="pt-4 border-t border-slate-800">
      <h4 class="text-xs font-bold text-slate-300 mb-3">Add Additional Network (Network 2, Network 3)</h4>
      <form action="/networks/create" method="POST" class="space-y-3">
        <div>
          <input type="text" name="name" required placeholder="Network Name (e.g. Cambridge Group)" class="w-full px-3.5 py-2 bg-slate-900 border border-slate-700/80 rounded-xl text-white text-xs focus:outline-none focus:border-indigo-500 transition" />
        </div>
        <div>
          <input type="text" name="rootDomain" required placeholder="Root Domain (e.g. cambridge-edu.org)" class="w-full px-3.5 py-2 bg-slate-900 border border-slate-700/80 rounded-xl text-white text-xs font-mono focus:outline-none focus:border-indigo-500 transition" />
        </div>
        <div>
          <input type="text" name="description" placeholder="Notes or organization name" class="w-full px-3.5 py-2 bg-slate-900 border border-slate-700/80 rounded-xl text-white text-xs focus:outline-none focus:border-indigo-500 transition" />
        </div>
        <button type="submit" class="w-full py-2.5 bg-slate-800 hover:bg-slate-700 text-white rounded-xl text-xs font-semibold border border-slate-700 transition">
          + Register Root Network
        </button>
      </form>
    </div>
  </div>

  <!-- Section 3: Bind Custom Domain to School -->
  <div class="glass-card rounded-2xl p-6 border border-slate-800 shadow-xl flex flex-col justify-between">
    <div>
      <h3 class="text-xs font-bold uppercase tracking-wider text-white mb-2">Bind Custom Domain to School</h3>
      <p class="text-xs text-slate-400 mb-6">Attach a client's dedicated apex or subdomain. The Caddy reverse proxy will issue a Let's Encrypt certificate automatically via On-Demand TLS upon first request.</p>

      <form action="/networks/bind-domain" method="POST" class="space-y-4">
        <div>
          <label class="block text-xs font-medium text-slate-300 mb-1.5">Select School Instance</label>
          <select name="schoolId" class="w-full px-4 py-2.5 bg-slate-900 border border-slate-700/80 rounded-xl text-white text-xs focus:outline-none focus:border-indigo-500 transition">
            <% schools.forEach(function(s) { %>
              <option value="<%= s.id %>"><%= s.name %> (<%= s.slug %>)</option>
            <% }); %>
          </select>
        </div>

        <div>
          <label class="block text-xs font-medium text-slate-300 mb-1.5">Custom Domain</label>
          <input type="text" name="customDomain" placeholder="portal.clientschool.edu" required class="w-full px-4 py-2.5 bg-slate-900 border border-slate-700/80 rounded-xl text-white text-xs font-mono focus:outline-none focus:border-indigo-500 transition" />
        </div>

        <button type="submit" class="w-full py-3 bg-indigo-600 hover:bg-indigo-500 text-white rounded-xl text-xs font-bold shadow-md shadow-indigo-600/20 transition">
          🔗 Bind Domain & Enable Auto-SSL
        </button>
      </form>
    </div>

    <!-- On Demand SSL Notice -->
    <div class="mt-6 p-4 bg-indigo-500/5 rounded-xl border border-indigo-500/20 text-xs text-slate-400">
      <span class="font-semibold text-indigo-300 block mb-1">🔐 Automated On-Demand TLS Engine</span>
      When the client points their CNAME record to your ingress, Caddy will verify the domain through the Master Dashboard API (<code class="text-slate-300">/api/v1/domains/validate</code>) and provision HTTPS within seconds.
    </div>
  </div>
</div>

<%- include('partials/footer') %>
