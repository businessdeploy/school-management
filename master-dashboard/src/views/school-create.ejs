<%- include('partials/header') %>

<div class="max-w-3xl mx-auto">
  <div class="mb-8">
    <a href="/schools" class="text-xs text-slate-400 hover:text-indigo-400 transition mb-2 inline-block">← Back to School Fleet</a>
    <h1 class="text-2xl font-extrabold text-white tracking-tight">Instant School Onboarding Wizard</h1>
    <p class="text-slate-400 text-sm mt-1">Provisions dedicated tenant database, seeds 196 tables, generates superadmin, and connects container in 5 seconds.</p>
  </div>

  <% if (error) { %>
    <div class="p-4 mb-6 rounded-2xl bg-rose-500/10 border border-rose-500/20 text-rose-400 text-xs font-medium flex items-center space-x-2">
      <span>⚠️</span>
      <span><%= error %></span>
    </div>
  <% } %>

  <div class="glass-card rounded-3xl p-8 border border-slate-800 shadow-2xl">
    <form action="/schools/create" method="POST" class="space-y-6">
      
      <!-- Section 1: Institution Identity -->
      <div>
        <h3 class="text-xs font-bold uppercase tracking-wider text-indigo-400 mb-4 flex items-center space-x-2">
          <span>1</span>
          <span>Institution Identity</span>
        </h3>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-medium text-slate-300 mb-1.5">School Name *</label>
            <input type="text" name="name" required placeholder="e.g. Oakridge International" class="w-full px-4 py-2.5 bg-slate-900 border border-slate-700/80 rounded-xl text-white text-xs focus:outline-none focus:border-indigo-500 transition" />
          </div>

          <div>
            <label class="block text-xs font-medium text-slate-300 mb-1.5">Subdomain Slug (URL Identifier) *</label>
            <div class="flex items-center">
              <input type="text" name="slug" required placeholder="oakridge" class="w-full px-4 py-2.5 bg-slate-900 border border-slate-700/80 rounded-xl text-white text-xs focus:outline-none focus:border-indigo-500 transition font-mono" />
            </div>
          </div>
        </div>
      </div>

      <!-- Section 2: Network & Custom Domain -->
      <div class="pt-4 border-t border-slate-800">
        <h3 class="text-xs font-bold uppercase tracking-wider text-indigo-400 mb-4 flex items-center space-x-2">
          <span>2</span>
          <span>Network & Domain Routing</span>
        </h3>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-medium text-slate-300 mb-1.5">Parent Network</label>
            <select name="networkId" class="w-full px-4 py-2.5 bg-slate-900 border border-slate-700/80 rounded-xl text-white text-xs focus:outline-none focus:border-indigo-500 transition">
              <% networks.forEach(function(n) { %>
                <option value="<%= n.id %>"><%= n.name %> (*.<%= n.rootDomain %>)</option>
              <% }); %>
            </select>
          </div>

          <div>
            <label class="block text-xs font-medium text-slate-300 mb-1.5">Custom Domain (Optional)</label>
            <input type="text" name="customDomain" placeholder="e.g. portal.oakridge.edu" class="w-full px-4 py-2.5 bg-slate-900 border border-slate-700/80 rounded-xl text-white text-xs focus:outline-none focus:border-indigo-500 transition font-mono" />
          </div>
        </div>
      </div>

      <!-- Section 3: Super Admin Access -->
      <div class="pt-4 border-t border-slate-800">
        <h3 class="text-xs font-bold uppercase tracking-wider text-indigo-400 mb-4 flex items-center space-x-2">
          <span>3</span>
          <span>School Super Admin Credentials</span>
        </h3>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-medium text-slate-300 mb-1.5">Super Admin Email *</label>
            <input type="email" name="adminEmail" required placeholder="admin@school.edu" class="w-full px-4 py-2.5 bg-slate-900 border border-slate-700/80 rounded-xl text-white text-xs focus:outline-none focus:border-indigo-500 transition" />
          </div>

          <div>
            <label class="block text-xs font-medium text-slate-300 mb-1.5">Initial Password</label>
            <input type="password" name="adminPassword" value="Admin@123456" class="w-full px-4 py-2.5 bg-slate-900 border border-slate-700/80 rounded-xl text-white text-xs focus:outline-none focus:border-indigo-500 transition" />
          </div>
        </div>
      </div>

      <!-- Section 4: Localization & Capacity -->
      <div class="pt-4 border-t border-slate-800">
        <h3 class="text-xs font-bold uppercase tracking-wider text-indigo-400 mb-4 flex items-center space-x-2">
          <span>4</span>
          <span>Quotas & Localization</span>
        </h3>
        <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
          <div>
            <label class="block text-xs font-medium text-slate-300 mb-1.5">Currency</label>
            <input type="text" name="currencySymbol" value="$" class="w-full px-4 py-2.5 bg-slate-900 border border-slate-700/80 rounded-xl text-white text-xs focus:outline-none focus:border-indigo-500 transition" />
          </div>

          <div>
            <label class="block text-xs font-medium text-slate-300 mb-1.5">Timezone</label>
            <input type="text" name="timezone" value="UTC" class="w-full px-4 py-2.5 bg-slate-900 border border-slate-700/80 rounded-xl text-white text-xs focus:outline-none focus:border-indigo-500 transition" />
          </div>

          <div>
            <label class="block text-xs font-medium text-slate-300 mb-1.5">Storage Quota (GB)</label>
            <input type="number" name="storageQuotaGb" value="10" min="1" class="w-full px-4 py-2.5 bg-slate-900 border border-slate-700/80 rounded-xl text-white text-xs focus:outline-none focus:border-indigo-500 transition" />
          </div>

          <div>
            <label class="block text-xs font-medium text-slate-300 mb-1.5">Max Students</label>
            <input type="number" name="maxStudents" value="1500" min="10" class="w-full px-4 py-2.5 bg-slate-900 border border-slate-700/80 rounded-xl text-white text-xs focus:outline-none focus:border-indigo-500 transition" />
          </div>
        </div>
      </div>

      <!-- Submit Actions -->
      <div class="pt-6 border-t border-slate-800 flex items-center justify-end space-x-3">
        <a href="/schools" class="px-5 py-3 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs font-medium transition">
          Cancel
        </a>
        <button type="submit" class="px-6 py-3 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-bold shadow-lg shadow-indigo-600/30 transition flex items-center space-x-2">
          <span>⚡</span>
          <span>Provision & Launch School</span>
        </button>
      </div>
    </form>
  </div>
</div>

<%- include('partials/footer') %>
