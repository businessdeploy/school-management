<%- include('partials/header') %>

<div class="max-w-3xl mx-auto">
  <div class="mb-6">
    <a href="/schools" class="text-xs text-slate-400 hover:text-indigo-400 transition mb-1 inline-flex items-center space-x-1">
      <i data-lucide="arrow-left" class="w-3.5 h-3.5"></i>
      <span>Back to School Fleet</span>
    </a>
    <h1 class="text-xl sm:text-2xl font-bold text-white tracking-tight">Onboard New School Instance</h1>
    <p class="text-slate-400 text-xs sm:text-sm mt-0.5">Provisions a dedicated tenant database, seeds the schema, creates the superadmin account, and configures routing.</p>
  </div>

  <% if (error) { %>
    <div class="p-3.5 mb-5 rounded-lg bg-rose-500/10 border border-rose-500/20 text-rose-400 text-xs font-medium flex items-center space-x-2">
      <i data-lucide="alert-triangle" class="w-4 h-4 text-rose-400"></i>
      <span><%= error %></span>
    </div>
  <% } %>

  <div class="control-surface p-6">
    <form action="/schools/create" method="POST" class="space-y-5 text-xs">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      
      <!-- Section 1: Institution Identity -->
      <div>
        <h2 class="text-xs font-semibold text-white mb-3 flex items-center space-x-2 border-b border-slate-800 pb-2">
          <i data-lucide="school" class="w-4 h-4 text-indigo-400"></i>
          <span>1. Institution Identity</span>
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3.5">
          <div>
            <label class="block text-[11px] font-medium text-slate-300 mb-1">School Name *</label>
            <input type="text" name="name" required placeholder="e.g. Oakridge International" class="w-full px-3 py-1.5 bg-slate-900 border border-slate-800 rounded-lg text-white text-xs focus:outline-none focus:border-indigo-500 transition" />
          </div>

          <div>
            <label class="block text-[11px] font-medium text-slate-300 mb-1">Subdomain Slug (URL Identifier) *</label>
            <input type="text" name="slug" required placeholder="oakridge" class="w-full px-3 py-1.5 bg-slate-900 border border-slate-800 rounded-lg text-white text-xs focus:outline-none focus:border-indigo-500 transition font-mono" />
          </div>
        </div>
      </div>

      <!-- Section 2: Network & Custom Domain -->
      <div class="pt-2">
        <h2 class="text-xs font-semibold text-white mb-3 flex items-center space-x-2 border-b border-slate-800 pb-2">
          <i data-lucide="network" class="w-4 h-4 text-indigo-400"></i>
          <span>2. Network &amp; Domain Routing</span>
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3.5">
          <div>
            <label class="block text-[11px] font-medium text-slate-300 mb-1">Parent Network</label>
            <select name="networkId" class="w-full px-3 py-1.5 bg-slate-900 border border-slate-800 rounded-lg text-white text-xs focus:outline-none focus:border-indigo-500 transition">
              <% networks.forEach(function(n) { %>
                <option value="<%= n.id %>"><%= n.name %> (*.<%= n.rootDomain %>)</option>
              <% }); %>
            </select>
          </div>

          <div>
            <label class="block text-[11px] font-medium text-slate-300 mb-1">Custom Domain (Optional)</label>
            <input type="text" name="customDomain" placeholder="e.g. portal.oakridge.edu" class="w-full px-3 py-1.5 bg-slate-900 border border-slate-800 rounded-lg text-white text-xs focus:outline-none focus:border-indigo-500 transition font-mono" />
          </div>
        </div>
      </div>

      <!-- Section 3: Super Admin Access -->
      <div class="pt-2">
        <h2 class="text-xs font-semibold text-white mb-3 flex items-center space-x-2 border-b border-slate-800 pb-2">
          <i data-lucide="shield-check" class="w-4 h-4 text-indigo-400"></i>
          <span>3. School Super Admin Credentials</span>
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3.5">
          <div>
            <label class="block text-[11px] font-medium text-slate-300 mb-1">Super Admin Email *</label>
            <input type="email" name="adminEmail" required placeholder="admin@school.edu" class="w-full px-3 py-1.5 bg-slate-900 border border-slate-800 rounded-lg text-white text-xs focus:outline-none focus:border-indigo-500 transition" />
          </div>

          <div>
            <label class="block text-[11px] font-medium text-slate-300 mb-1">Initial Password</label>
            <input type="password" name="adminPassword" value="Admin@123456" class="w-full px-3 py-1.5 bg-slate-900 border border-slate-800 rounded-lg text-white text-xs focus:outline-none focus:border-indigo-500 transition" />
          </div>
        </div>
      </div>

      <!-- Section 4: Localization & Capacity -->
      <div class="pt-2">
        <h2 class="text-xs font-semibold text-white mb-3 flex items-center space-x-2 border-b border-slate-800 pb-2">
          <i data-lucide="sliders" class="w-4 h-4 text-indigo-400"></i>
          <span>4. Quotas &amp; Localization</span>
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3.5">
          <div>
            <label class="block text-[11px] font-medium text-slate-300 mb-1">Currency Symbol</label>
            <input type="text" name="currencySymbol" value="₹" class="w-full px-3 py-1.5 bg-slate-900 border border-slate-800 rounded-lg text-white text-xs focus:outline-none focus:border-indigo-500 transition" />
          </div>

          <div>
            <label class="block text-[11px] font-medium text-slate-300 mb-1">Timezone</label>
            <input type="text" name="timezone" value="Asia/Kolkata" class="w-full px-3 py-1.5 bg-slate-900 border border-slate-800 rounded-lg text-white text-xs focus:outline-none focus:border-indigo-500 transition" />
          </div>

          <div>
            <label class="block text-[11px] font-medium text-slate-300 mb-1">Storage Quota (GB)</label>
            <input type="number" name="storageQuotaGb" value="10" min="1" class="w-full px-3 py-1.5 bg-slate-900 border border-slate-800 rounded-lg text-white text-xs focus:outline-none focus:border-indigo-500 transition" />
          </div>

          <div>
            <label class="block text-[11px] font-medium text-slate-300 mb-1">Max Students</label>
            <input type="number" name="maxStudents" value="1500" min="10" class="w-full px-3 py-1.5 bg-slate-900 border border-slate-800 rounded-lg text-white text-xs focus:outline-none focus:border-indigo-500 transition" />
          </div>
        </div>
      </div>

      <!-- Submit Actions -->
      <div class="pt-4 border-t border-slate-800 flex items-center justify-end space-x-2">
        <a href="/schools" class="btn-control btn-control-secondary">
          Cancel
        </a>
        <button type="submit" class="btn-control btn-control-primary">
          <i data-lucide="plus" class="w-3.5 h-3.5"></i>
          <span>Provision &amp; Launch School</span>
        </button>
      </div>
    </form>
  </div>
</div>

<%- include('partials/footer') %>
